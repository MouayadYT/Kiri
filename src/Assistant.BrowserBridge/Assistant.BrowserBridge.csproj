<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser native-messaging host; console subsystem for stdio (PROJECT_SPEC §4.5, §5.7). The browser starts it for each message
       from the extension, so it is kept small and quick to start: no host, no dependency injection, no logging, no culture data. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>..\Assistant.ExplorerExtension\Assets\Assistant.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Assistant.BrowserBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assistant.Core\Assistant.Core.csproj" />
  </ItemGroup>

</Project>
