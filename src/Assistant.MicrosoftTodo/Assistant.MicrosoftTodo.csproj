<Project Sdk="Microsoft.NET.Sdk">

  <!-- Microsoft To Do for the Assistant (PROJECT_SPEC section 4.8): a small MCP server that ships beside the app and that the Assistant starts when a request is about Microsoft To Do.
       It speaks the protocol over its standard input and output and talks to Microsoft Graph with the access token the Assistant gives it in an environment variable after the
       user signed in to Microsoft in their browser. It never signs in itself, never writes a file and never deletes anything. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>..\Assistant.ExplorerExtension\Assets\Assistant.ico</ApplicationIcon>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Assistant.Tools.Tests" />
  </ItemGroup>

</Project>
