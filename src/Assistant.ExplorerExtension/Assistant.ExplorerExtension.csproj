<Project Sdk="Microsoft.NET.Sdk">

  <!-- Out-of-process File Explorer entry point; no console window (PROJECT_SPEC §4.4). It runs once for each file the user
       sends, so it is kept small and quick to start: no host, no dependency injection, no logging, no culture data, and JSON
       written by hand. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Source-generated P/Invoke (LibraryImport). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The icon of Ask Assistant in File Explorer's menu is this file's own (PROJECT_SPEC §4.4). -->
    <ApplicationIcon>Assets\Assistant.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The Kiri icon for both menu themes, kept under the existing names for registered Explorer entries.
       They ship beside the entry point, and with the app that references it. -->
  <ItemGroup>
    <Content Include="Assets\AskAssistant.dark.ico" Link="AskAssistant.dark.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AskAssistant.light.ico" Link="AskAssistant.light.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sparse package's logo (TopMenu/TopMenuPackage), copied beside the manifest when the package is registered. -->
    <Content Include="Assets\PackageLogo.png" Link="PackageLogo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Assistant.ExplorerExtension.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assistant.Core\Assistant.Core.csproj" />
  </ItemGroup>

</Project>
