<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF text, read by the library itself (managed, no native code, never renders or runs anything in the file). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- DOCX and PPTX, read through the Open XML SDK (a package of XML parts: nothing in it is ever run). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assistant.Core\Assistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Assistant.Documents.Tests" />
  </ItemGroup>

</Project>
