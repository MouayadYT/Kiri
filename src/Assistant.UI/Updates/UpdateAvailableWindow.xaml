<Window x:Class="Assistant.UI.Updates.UpdateAvailableWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available"
        Width="420" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner">

    <!-- Says that a newer release is on GitHub, the way the permission question is drawn: which version, which one is running, and two buttons. Open update
         page opens the release's page in the browser; Ignore this version (and Esc, and closing it) keeps that version from being announced again. Nothing is
         downloaded or installed from here. -->
    <Border Margin="14" CornerRadius="18" Background="{StaticResource Brush.Surface.SidebarOpaque}"
            BorderBrush="{StaticResource Brush.Stroke.ControlRim}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="22,20,22,20">
            <TextBlock x:Name="Heading" Style="{StaticResource Text.Heading}" FontSize="{StaticResource FontSize.Body}" TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="Detail" Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource Text.BodySmall}"
                       Foreground="{StaticResource Brush.Text.Secondary}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="IgnoreButton" Style="{StaticResource ImageSearch.DialogButton}" Content="Ignore this version" IsCancel="True" MinWidth="96"
                        Padding="14,6" AutomationProperties.Name="Ignore this version" />
                <Button x:Name="OpenButton" Style="{StaticResource ImageSearch.DialogPrimary}" Content="Open update page" IsDefault="True" MinWidth="96" Padding="14,6"
                        Margin="10,0,0,0" AutomationProperties.Name="Open the update's page on GitHub" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
