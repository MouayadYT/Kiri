<Window x:Class="Assistant.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Assistant.UI.Controls"
        xmlns:views="clr-namespace:Assistant.UI.Views"
        Title="Settings"
        Width="940" Height="700" MinWidth="720" MinHeight="460"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="Transparent" WindowStartupLocation="Manual">

    <!-- The Assistant's settings (PROJECT_SPEC §4.9), in the History window's own visual language: the same Windows-drawn
         Mica frame and hairline, the same sidebar and workspace layers, the same window buttons at the top left, and cards,
         rows and glass controls built from the same tokens (Themes/Controls/Settings.xaml). The sidebar lists the sections
         and the workspace shows the open one's page, bound to the real settings (SettingsViewModel), which saves each change
         as it is made. The band along the top moves the window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource History.CaptionHeight}" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="SystemCommands.CloseWindowCommand" Executed="OnCloseExecuted" />
        <CommandBinding Command="SystemCommands.MinimizeWindowCommand" Executed="OnMinimizeExecuted" />
        <CommandBinding Command="SystemCommands.MaximizeWindowCommand" Executed="OnMaximizeExecuted" />
    </Window.CommandBindings>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Settings.SidebarWidth}" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- The sidebar: the sections, the open one on a lighter layer. -->
        <Grid x:Name="Sidebar" Style="{StaticResource HistorySidebar}">
            <ListBox x:Name="Sections" Style="{StaticResource SettingsNavList}" ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection}" AutomationProperties.Name="Settings sections" />

            <StackPanel x:Name="WindowButtons" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="{StaticResource History.WindowButtonsMargin}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="CloseButton" Style="{StaticResource WindowButton}"
                        Background="{StaticResource Brush.WindowButton.Close}" Tag="{StaticResource Icon.WindowClose}"
                        Command="SystemCommands.CloseWindowCommand" AutomationProperties.Name="Close" />
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}"
                        Background="{StaticResource Brush.WindowButton.Minimize}" Tag="{StaticResource Icon.WindowMinimize}"
                        Command="SystemCommands.MinimizeWindowCommand" AutomationProperties.Name="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}"
                        Background="{StaticResource Brush.WindowButton.Maximize}" Tag="{StaticResource Icon.WindowMaximize}"
                        Command="SystemCommands.MaximizeWindowCommand" AutomationProperties.Name="Maximize" />
            </StackPanel>
        </Grid>

        <!-- The workspace: the open section's title and page, passing under the window's top band as they scroll. -->
        <Grid x:Name="Workspace" Grid.Column="1" Style="{StaticResource HistoryWorkspace}">
            <controls:FadingScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Hidden" PreviewMouseWheel="OnPageMouseWheel"
                                         HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                         TopFade="{StaticResource Settings.TopFade}"
                                         BottomFade="{StaticResource Settings.BottomFade}">
                <StackPanel x:Name="Page" MaxWidth="{StaticResource Settings.PageWidth}"
                            Margin="{StaticResource Settings.PageMargin}">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource Text.SettingsTitle}" Text="{Binding SelectedSection.Title}"
                               Margin="0,0,0,18" AutomationProperties.HeadingLevel="Level1" />

                    <!-- Something the settings need the user to know: they could not be read as they were left, or the
                         last change could not be saved. -->
                    <HeaderedContentControl x:Name="NoticeCard" Style="{StaticResource SettingsGroup}"
                                            Visibility="{Binding HasNotice, Converter={StaticResource Settings.ShowWhenTrue}}">
                        <TextBlock x:Name="NoticeText" Text="{Binding Notice}" Margin="18,14,18,14"
                                   Style="{StaticResource Text.SettingsDescription}"
                                   Foreground="{StaticResource Brush.Settings.Warning}"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </HeaderedContentControl>

                    <ContentControl x:Name="PageContent" Content="{Binding CurrentPage}" IsTabStop="False" />
                </StackPanel>
            </controls:FadingScrollViewer>
        </Grid>
    </Grid>
</Window>
