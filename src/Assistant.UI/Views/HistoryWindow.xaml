<Window x:Class="Assistant.UI.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="clr-namespace:Assistant.UI.Controls"
        xmlns:views="clr-namespace:Assistant.UI.Views"
        xmlns:vm="clr-namespace:Assistant.UI.ViewModels"
        Title="Assistant"
        Width="1440" Height="824" MinWidth="720" MinHeight="440"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="Transparent" WindowStartupLocation="Manual">

    <!-- The Assistant's full window, for history and long conversations (PROJECT_SPEC §4.3), laid out from its
         reference (Themes/Controls/History.xaml): a sidebar of conversations on the left, as cards or as a list, and
         the workspace on the right. Windows draws its frame, shadow, rounded corners and dark backdrop
         (Windowing/WindowFrameHost), so it resizes, snaps and maximizes like any window; the window draws everything
         inside, with its own buttons. The band along the top moves it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource History.CaptionHeight}" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="SystemCommands.CloseWindowCommand" Executed="OnCloseExecuted" />
        <CommandBinding Command="SystemCommands.MinimizeWindowCommand" Executed="OnMinimizeExecuted" />
        <CommandBinding Command="SystemCommands.MaximizeWindowCommand" Executed="OnMaximizeExecuted" />
        <CommandBinding Command="{x:Static views:HistoryWindow.ShowViewMenuCommand}" Executed="OnShowViewMenuExecuted" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>

    <Window.Resources>
        <!-- The list's sections: the conversations, newest first, under the span of time each last changed in, the
             most recent span first. A conversation moves to another section when it changes or as the days pass. -->
        <CollectionViewSource x:Key="ConversationSections" Source="{Binding Conversations}"
                              IsLiveGroupingRequested="True" Filter="OnFilterConversations">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section"
                                          CustomSort="{x:Static controls:GroupNameOrder.Instance}" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.LiveGroupingProperties>
                <sys:String>Section</sys:String>
            </CollectionViewSource.LiveGroupingProperties>
        </CollectionViewSource>

        <!-- The cards: the same conversations, without sections. A search leaves out the conversations it did not find,
             in both views. -->
        <CollectionViewSource x:Key="ConversationCards" Source="{Binding Conversations}"
                              Filter="OnFilterConversations" />
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource History.SidebarWidth}" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- The sidebar: the conversations, newest first, as cards in two staggered columns or as a list in sections,
             as the view menu chooses. Both show the open conversation as selected. -->
        <Grid x:Name="Sidebar" Style="{StaticResource HistorySidebar}">
            <ListBox x:Name="Conversations" ItemsSource="{Binding Source={StaticResource ConversationCards}}"
                     SelectedItem="{Binding Selected}" IsSynchronizedWithCurrentItem="False"
                     AutomationProperties.Name="Conversations">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource HistoryConversationList}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Layout}" Value="{x:Static vm:HistoryLayout.List}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
            </ListBox>

            <!-- Rows leave the list for a moment when they move to another section, so what the user chooses here
                 is passed on by OnRowsSelectionChanged rather than by the binding. -->
            <ListBox x:Name="ConversationRows" ItemsSource="{Binding Source={StaticResource ConversationSections}}"
                     SelectedItem="{Binding Selected, Mode=OneWay}" SelectionChanged="OnRowsSelectionChanged"
                     IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Conversations">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource HistoryConversationRows}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Layout}" Value="{x:Static vm:HistoryLayout.List}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource HistorySectionContainer}"
                                HeaderTemplate="{StaticResource HistorySectionHeader}" />
                </ListBox.GroupStyle>
            </ListBox>

            <!-- What the sidebar says while a search has found no conversation. -->
            <TextBlock x:Name="NoResults" Text="No Results" Style="{StaticResource Text.NoResults}" />

            <StackPanel x:Name="WindowButtons" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="{StaticResource History.WindowButtonsMargin}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="CloseButton" Style="{StaticResource WindowButton}"
                        Background="{StaticResource Brush.WindowButton.Close}" Tag="{StaticResource Icon.WindowClose}"
                        Command="SystemCommands.CloseWindowCommand" AutomationProperties.Name="Close" />
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}"
                        Background="{StaticResource Brush.WindowButton.Minimize}" Tag="{StaticResource Icon.WindowMinimize}"
                        Command="SystemCommands.MinimizeWindowCommand" AutomationProperties.Name="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}"
                        Background="{StaticResource Brush.WindowButton.Maximize}" Tag="{StaticResource Icon.WindowMaximize}"
                        Command="SystemCommands.MaximizeWindowCommand" AutomationProperties.Name="Maximize" />
            </StackPanel>

            <!-- Opens the view menu, which shows the conversations as a grid or as a list. -->
            <Button x:Name="FilterButton" Style="{StaticResource GlassMenuButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="{StaticResource History.FilterButtonMargin}"
                    ContentTemplate="{StaticResource Glyph.Filter}" WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{x:Static views:HistoryWindow.ShowViewMenuCommand}"
                    AutomationProperties.Name="View options">
                <Button.ContextMenu>
                    <ContextMenu x:Name="ViewMenu" Style="{StaticResource HistoryViewMenu}"
                                 AutomationProperties.Name="View">
                        <MenuItem x:Name="GridMenuItem" Header="Grid" Command="{Binding ShowGridCommand}"
                                  IsChecked="{Binding IsGrid, Mode=OneWay}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource IconGlyph}" StrokeThickness="1"
                                      Data="{StaticResource Icon.ViewGrid}" HorizontalAlignment="Right"
                                      Margin="0,0.55,0,0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ListMenuItem" Header="List" Command="{Binding ShowListCommand}"
                                  IsChecked="{Binding IsList, Mode=OneWay}">
                            <MenuItem.Icon>
                                <Path Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                      Data="{StaticResource Icon.ViewList}" HorizontalAlignment="Right" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- The workspace: the open conversation, or word that none is. -->
        <Grid x:Name="Workspace" Grid.Column="1" Style="{StaticResource HistoryWorkspace}">
            <TextBlock x:Name="EmptyState" Text="No Conversation Selected" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="{StaticResource History.EmptyStateMargin}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.EmptyState}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- The open conversation, drawn by the same view as the floating conversation (Views/ConversationView) in a
                 column centered on the workspace, with no surface of its own. Its cards are measured from the larger reference. -->
            <!-- Here, in the full window, the words of a message can be selected and copied. -->
            <views:ConversationView x:Name="Conversation" Messages="{Binding Selected.Messages}"
                                    controls:SelectableTextBlock.IsSelectionEnabled="True"
                                    ColumnWidth="{StaticResource History.TranscriptWidth}"
                                    ContentPadding="{StaticResource History.TranscriptPadding}"
                                    TopFade="{StaticResource History.TranscriptTopFade}"
                                    BottomFade="{StaticResource History.TranscriptBottomFade}">
                <views:ConversationView.Resources>
                    <StaticResource x:Key="Message.CardBleed" ResourceKey="History.TranscriptCardBleed" />
                    <StaticResource x:Key="Message.CardSpacing" ResourceKey="History.TranscriptCardSpacing" />
                    <StaticResource x:Key="Message.CardPadding" ResourceKey="History.TranscriptCardPadding" />
                </views:ConversationView.Resources>
                <views:ConversationView.Style>
                    <Style TargetType="views:ConversationView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:ConversationView.Style>
            </views:ConversationView>

            <!-- The input bar along the bottom, while a conversation is open: a glass disc to add to a message (its menu offers
                 Photos and Files), a pill of glass to type in and a disc for the microphone. The messages pass under it. Enter
                 sends what is typed, as the next message of the open conversation (Shift+Enter starts a new line), and while an
                 answer comes the microphone's disc becomes Stop. Speaking waits for its own step. -->
            <Grid x:Name="Composer" VerticalAlignment="Bottom" Margin="{StaticResource History.ComposerMargin}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AttachButton" Style="{StaticResource GlassIconButton}" VerticalAlignment="Bottom"
                        Width="{StaticResource History.ComposerButtonSize}"
                        Height="{StaticResource History.ComposerButtonSize}"
                        Margin="{StaticResource History.ComposerAttachMargin}"
                        ContentTemplate="{StaticResource Glyph.Plus}" AutomationProperties.Name="Add" />
                <Grid x:Name="ComposerField" Grid.Column="1">
                    <controls:PanelShape Fill="{StaticResource Brush.Control.Glass}"
                                         Stroke="{StaticResource Brush.Stroke.ControlRim}"
                                         StrokeThickness="{StaticResource StrokeThickness.Hairline}"
                                         CornerSize="{StaticResource History.ComposerCorner}" />
                    <StackPanel>
                        <!-- What the next message is about, as the same row of chips above what is typed, inside the same glass. -->
                        <controls:AttachmentChipList x:Name="ComposerAttachments" ItemsSource="{Binding Chips}"
                                                     Style="{StaticResource AttachmentChipList}" Margin="10,8,10,0"
                                                     AutomationProperties.Name="Attachments" />
                        <controls:PromptInputControl x:Name="ComposerInput" Style="{StaticResource HistoryComposerInput}"
                                                     Placeholder="Ask Assistant"
                                                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                                     LiveText="{Binding Voice.Transcript}"
                                                     IsMicrophoneActive="{Binding Voice.IsListening, FallbackValue=False}"
                                                     SubmitCommand="{Binding SendCommand}" />
                    </StackPanel>
                </Grid>
                <Button x:Name="ComposerVoiceButton" Grid.Column="2" VerticalAlignment="Bottom"
                        Width="{StaticResource History.ComposerButtonSize}"
                        Height="{StaticResource History.ComposerButtonSize}"
                        Margin="{StaticResource History.ComposerVoiceMargin}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
                            <Setter Property="ContentTemplate" Value="{StaticResource Glyph.Microphone}" />
                            <Setter Property="AutomationProperties.Name" Value="Use microphone" />

                            <!-- The window's own microphone: pressed, it listens, and what is said is sent when the speaker stops; pressed again, it stops
                                 listening. Lit while it listens. While an answer comes the button stops the answer instead. -->
                            <Setter Property="Command" Value="{Binding Voice.ToggleCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Voice.IsListening}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Control.GlassOpen}" />
                                    <Setter Property="AutomationProperties.Name" Value="Stop listening" />
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Listening" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAnswering}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource Glyph.Stop}" />
                                    <Setter Property="AutomationProperties.Name" Value="Stop" />
                                    <Setter Property="Command" Value="{Binding StopCommand}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Why the microphone stopped, over the composer's right end, only after it fails. It takes no room of its own. -->
                <TextBlock x:Name="ComposerVoiceStatus" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,-22,16,0" IsHitTestVisible="False" Text="{Binding Voice.FailureMessage}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Voice.FailureMessage, FallbackValue={x:Null}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Starts a new conversation in the workspace, ready for its first message. -->
            <Button x:Name="ComposeButton" Style="{StaticResource GlassIconButton}" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="{StaticResource History.ComposeButtonMargin}"
                    ContentTemplate="{StaticResource Glyph.Compose}" WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding NewConversationCommand}" AutomationProperties.Name="New conversation" />

            <!-- Searches the conversations, on this device alone: the search button opens into a field, and what is typed
                 there lists only the conversations whose title or messages match, each showing the words that matched, in
                 the sidebar. Esc, or the button at the field's end, clears the search and puts the field away. -->
            <Grid x:Name="SearchArea" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="{StaticResource History.SearchButtonMargin}">
                <Button x:Name="SearchButton" ContentTemplate="{StaticResource Glyph.Search}"
                        WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding OpenSearchCommand}"
                        AutomationProperties.Name="Search conversations">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Grid x:Name="SearchField" Width="{StaticResource History.SearchFieldWidth}"
                      Height="{StaticResource Size.GlassButton}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <controls:PanelShape Fill="{StaticResource Brush.Control.Glass}"
                                         Stroke="{StaticResource Brush.Stroke.ControlRim}"
                                         StrokeThickness="{StaticResource StrokeThickness.Hairline}"
                                         CornerSize="{StaticResource History.SearchFieldCorner}" />
                    <ContentControl ContentTemplate="{StaticResource Glyph.Search}" Content="{x:Null}"
                                    Foreground="{StaticResource Brush.Glyph.OnGlass}" IsHitTestVisible="False"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="{StaticResource History.SearchGlyphMargin}" Opacity="0.7" />
                    <controls:PromptInputControl x:Name="SearchInput" Style="{StaticResource HistorySearchInput}"
                                                 Placeholder="Search"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseSearchButton" Style="{StaticResource CircularIconButton}"
                            HorizontalAlignment="Right" Width="{StaticResource History.SearchClearSize}"
                            Height="{StaticResource History.SearchClearSize}"
                            Margin="{StaticResource History.SearchClearMargin}"
                            Command="{Binding CloseSearchCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Close search">
                        <Path Style="{StaticResource IconGlyph}" Data="{StaticResource Icon.Close}" StrokeThickness="1.4" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
