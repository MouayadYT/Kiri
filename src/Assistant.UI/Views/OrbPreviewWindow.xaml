<Window x:Class="Assistant.UI.Views.OrbPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Assistant.UI.Controls"
        xmlns:orb="clr-namespace:Assistant.UI.Orb"
        Title="Assistant orb preview"
        Width="440" Height="600" ResizeMode="CanMinimize" ShowInTaskbar="True" Topmost="True"
        Background="White" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#FF0F172A">

    <!-- A place to see the assistant orb move before the voice pipeline exists: it shows the orb on white, as in the
         reference, in each state, fed with invented speech, a slider or the real microphone through the orb's one
         amplitude input. Opened by asking "demo orb". Nothing here is recorded or sent anywhere. -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#FF64748B"
                   Text="A sample of the assistant orb. Sound only moves it while it is Listening; Thinking and Error ignore it." />

        <controls:AssistantOrb x:Name="Orb" Grid.Row="1" Width="160" Height="160"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0"
                               State="Listening" />

        <StackPanel Grid.Row="2" Margin="0,4,0,0">
            <TextBlock Text="State" FontWeight="SemiBold" Margin="0,0,0,6" />
            <UniformGrid Rows="1">
                <RadioButton x:Name="IdleButton" Content="Idle" GroupName="State" Checked="OnStateChecked" Tag="{x:Static orb:OrbState.Idle}" />
                <RadioButton x:Name="ListeningButton" Content="Listening" GroupName="State" IsChecked="True" Checked="OnStateChecked" Tag="{x:Static orb:OrbState.Listening}" />
                <RadioButton x:Name="ThinkingButton" Content="Thinking" GroupName="State" Checked="OnStateChecked" Tag="{x:Static orb:OrbState.Thinking}" />
                <RadioButton x:Name="ErrorButton" Content="Error" GroupName="State" Checked="OnStateChecked" Tag="{x:Static orb:OrbState.Error}" />
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="Sound" FontWeight="SemiBold" Margin="0,0,0,6" />
            <UniformGrid Rows="1">
                <RadioButton x:Name="SpeechButton" Content="Invented speech" GroupName="Sound" IsChecked="True" Checked="OnSoundChecked" />
                <RadioButton x:Name="SliderButton" Content="Slider" GroupName="Sound" Checked="OnSoundChecked" />
                <RadioButton x:Name="MicrophoneButton" Content="Microphone" GroupName="Sound" Checked="OnSoundChecked" />
            </UniformGrid>
            <Slider x:Name="LevelSlider" Minimum="0" Maximum="1" Value="0.5" Margin="0,12,0,0" IsEnabled="False"
                    AutomationProperties.Name="Amplitude" />
            <TextBlock x:Name="Readout" Margin="0,8,0,0" Foreground="#FF64748B" Text="Amplitude 0.00" />
            <TextBlock x:Name="Notice" Margin="0,4,0,0" Foreground="#FFB91C1C" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
