<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Outline glyphs, drawn with the IconGlyph style. Coordinates are DIPs and leave room for half the glyph
         stroke on every side. -->

    <!-- 14.5 × 22.75: a capsule on a cradle and stand. -->
    <Geometry x:Key="Icon.Microphone">
        M 4.25,3.75 V 11 A 3,3 0 0 0 10.25,11 V 3.75 A 3,3 0 0 0 4.25,3.75 Z
        M 0.75,8.75 V 11 A 6.5,6.5 0 0 0 13.75,11 V 8.75
        M 7.25,17.5 V 22
        M 2.75,22 H 11.75
    </Geometry>

    <!-- 10.6 × 16.4: the same microphone, smaller, for a glass button. -->
    <Geometry x:Key="Icon.MicrophoneSmall">
        M 3.2,2.85 V 7.925 A 2.1,2.1 0 0 0 7.4,7.925 V 2.85 A 2.1,2.1 0 0 0 3.2,2.85 Z
        M 0.75,6.35 V 7.925 A 4.55,4.55 0 0 0 9.85,7.925 V 6.35
        M 5.3,12.475 V 15.625
        M 2.15,15.625 H 8.45
    </Geometry>

    <!-- The floating conversation's glyphs, sized from its reference. Close and Expand are drawn with a 1.6 stroke,
         Keyboard with 1.25, and the speaker waves with 1.3. -->

    <!-- 10.4 × 10.4: a cross. -->
    <Geometry x:Key="Icon.Close">M 0.8,0.8 L 9.6,9.6 M 9.6,0.8 L 0.8,9.6</Geometry>

    <!-- 13.6 × 13.6: arrows out to two opposite corners. -->
    <Geometry x:Key="Icon.Expand">
        M 7.8,0.8 H 12.8 V 5.8 M 12.8,0.8 L 8.3,5.3
        M 0.8,7.8 V 12.8 H 5.8 M 0.8,12.8 L 5.3,8.3
    </Geometry>

    <!-- 8.4 × 12.2, filled: a loudspeaker. -->
    <Geometry x:Key="Icon.Speaker">
        M 1,3.6 H 3.5 L 7.3,0.5 C 7.8,0.1 8.4,0.4 8.4,1 V 11.2 C 8.4,11.8 7.8,12.1 7.3,11.7 L 3.5,8.6 H 1
        C 0.45,8.6 0,8.15 0,7.6 V 4.6 C 0,4.05 0.45,3.6 1,3.6 Z
    </Geometry>

    <!-- The loudspeaker's two sound waves, to its right in the same 16 × 12.2 space. -->
    <Geometry x:Key="Icon.SpeakerWaves">
        M 10.9,3.6 A 4,4 0 0 1 10.9,8.6
        M 13.6,1.5 A 7,7 0 0 1 13.6,10.7
    </Geometry>

    <!-- Glyphs of message content, sized from the result card reference. -->

    <!-- 13.5 × 12: a warning triangle with an exclamation mark, for a warning in an answer. -->
    <Geometry x:Key="Icon.Warning">
        M 6.75,1.4 L 12.4,10.6 A 0.6,0.6 0 0 1 11.9,11.25 H 1.6 A 0.6,0.6 0 0 1 1.1,10.6 Z
        M 6.75,4.9 V 7.6
        M 6.75,9.2 V 9.25
    </Geometry>

    <!-- 10 × 12.5, filled: two pages, one in front of the other, each with a folded corner. The gaps that set the front
         page and the folds apart are cut out, so they show whatever is behind the glyph. -->
    <CombinedGeometry x:Key="Icon.Copy" GeometryCombineMode="Union">
        <CombinedGeometry.Geometry1>
            <CombinedGeometry GeometryCombineMode="Exclude"
                              Geometry2="M 6.4,-0.1 H 6.9 V 2.8 H 9.8 V 3.3 H 6.4 Z">
                <CombinedGeometry.Geometry1>
                    <CombinedGeometry GeometryCombineMode="Exclude"
                                      Geometry1="M 3.6,0 L 6.9,0 L 9.7,2.8 L 9.7,8.85 A 1,1 0 0 1 8.7,9.85 L 3.6,9.85 A 1,1 0 0 1 2.6,8.85 L 2.6,1 A 1,1 0 0 1 3.6,0 Z"
                                      Geometry2="M -0.35,2 L 4.5,2 L 8.3,6.1 L 8.3,12.85 L -0.35,12.85 Z" />
                </CombinedGeometry.Geometry1>
            </CombinedGeometry>
        </CombinedGeometry.Geometry1>
        <CombinedGeometry.Geometry2>
            <CombinedGeometry GeometryCombineMode="Exclude"
                              Geometry1="M 1.15,2.5 L 4,2.5 L 7.8,6.3 L 7.8,11.35 A 1,1 0 0 1 6.8,12.35 L 1.15,12.35 A 1,1 0 0 1 0.15,11.35 L 0.15,3.5 A 1,1 0 0 1 1.15,2.5 Z"
                              Geometry2="M 3.5,2.4 H 4 V 6.3 H 7.9 V 6.8 H 3.5 Z" />
        </CombinedGeometry.Geometry2>
    </CombinedGeometry>

    <!-- 10 × 8.7: a check mark, drawn with a 1.6 stroke, shown for a moment after something is copied. -->
    <Geometry x:Key="Icon.Check">M 0.8,4.6 L 3.7,7.5 L 9.2,1.2</Geometry>

    <!-- 14 × 18: a page with a folded corner, for a file without a short type. -->
    <Geometry x:Key="Icon.Document">
        M 1.75,0.75 H 8.75 L 13.25,5.25 V 16.25 A 1,1 0 0 1 12.25,17.25 H 1.75 A 1,1 0 0 1 0.75,16.25 V 1.75
        A 1,1 0 0 1 1.75,0.75 Z M 8.75,0.75 V 5.25 H 13.25
    </Geometry>

    <!-- 12 × 10: three lines of text, the last shorter, for a piece of text. -->
    <Geometry x:Key="Icon.TextLines">M 0.75,0.75 H 11.25 M 0.75,5 H 11.25 M 0.75,9.25 H 7.25</Geometry>

    <!-- 18 × 14: a folder. -->
    <Geometry x:Key="Icon.Folder">
        M 0.75,2.25 A 1.5,1.5 0 0 1 2.25,0.75 H 6.5 L 8.25,2.75 H 15.75 A 1.5,1.5 0 0 1 17.25,4.25 V 11.75
        A 1.5,1.5 0 0 1 15.75,13.25 H 2.25 A 1.5,1.5 0 0 1 0.75,11.75 Z M 0.75,5 H 17.25
    </Geometry>

    <!-- 16 × 16: four tiles, for an app. -->
    <Geometry x:Key="Icon.App">
        M 1.75,0.75 H 5.75 A 1,1 0 0 1 6.75,1.75 V 5.75 A 1,1 0 0 1 5.75,6.75 H 1.75 A 1,1 0 0 1 0.75,5.75 V 1.75 A 1,1 0 0 1 1.75,0.75 Z
        M 10.25,0.75 H 14.25 A 1,1 0 0 1 15.25,1.75 V 5.75 A 1,1 0 0 1 14.25,6.75 H 10.25 A 1,1 0 0 1 9.25,5.75 V 1.75 A 1,1 0 0 1 10.25,0.75 Z
        M 1.75,9.25 H 5.75 A 1,1 0 0 1 6.75,10.25 V 14.25 A 1,1 0 0 1 5.75,15.25 H 1.75 A 1,1 0 0 1 0.75,14.25 V 10.25 A 1,1 0 0 1 1.75,9.25 Z
        M 10.25,9.25 H 14.25 A 1,1 0 0 1 15.25,10.25 V 14.25 A 1,1 0 0 1 14.25,15.25 H 10.25 A 1,1 0 0 1 9.25,14.25 V 10.25 A 1,1 0 0 1 10.25,9.25 Z
    </Geometry>

    <!-- The History window's glyphs, sized from its reference and drawn with a 1.6 stroke, the search glyph's with 1.8. -->

    <!-- 13.9 × 9.8: three lines, each shorter than the one above, for narrowing the list. -->
    <Geometry x:Key="Icon.Filter">M 0.8,0.8 H 13.1 M 2.25,4.9 H 11.65 M 3.75,9 H 10.15</Geometry>

    <!-- 15.4 × 15.3: a page with a pencil across its open corner, for a new conversation. -->
    <Geometry x:Key="Icon.Compose">
        M 7,2.1 H 3.4 A 2.6,2.6 0 0 0 0.8,4.7 V 11.9 A 2.6,2.6 0 0 0 3.4,14.5 H 10 A 2.6,2.6 0 0 0 12.6,11.9 V 8.3
        M 14.6,0.8 L 7.4,8 L 6.6,9.2 L 7.8,8.4 Z
    </Geometry>

    <!-- 15.4 × 15.4: a magnifying glass, for searching conversations. -->
    <Geometry x:Key="Icon.Search">
        M 11.8,6.35 A 5.45,5.45 0 1 1 0.9,6.35 A 5.45,5.45 0 1 1 11.8,6.35 Z M 10.3,10.3 L 14.5,14.5
    </Geometry>

    <!-- 11.3 × 11.3: a plus, for adding to the input bar's message, drawn with a 1.6 stroke. -->
    <Geometry x:Key="Icon.Plus">M 0.8,5.65 H 10.5 M 5.65,0.8 V 10.5</Geometry>

    <!-- The History window's view menu, sized from its reference. -->

    <!-- 9.05 × 8.9: a check mark in front of the chosen item, drawn with a 1.9 stroke. -->
    <Geometry x:Key="Icon.MenuCheck">M 0.95,4.9 L 3.5,7.95 L 8.1,0.95</Geometry>

    <!-- 9.46 × 9.46: four rounded squares, for the grid of cards, drawn with a 1 stroke. -->
    <GeometryGroup x:Key="Icon.ViewGrid">
        <RectangleGeometry Rect="0.5,0.5,3.37,3.37" RadiusX="0.85" RadiusY="0.85" />
        <RectangleGeometry Rect="5.59,0.5,3.37,3.37" RadiusX="0.85" RadiusY="0.85" />
        <RectangleGeometry Rect="0.5,5.59,3.37,3.37" RadiusX="0.85" RadiusY="0.85" />
        <RectangleGeometry Rect="5.59,5.59,3.37,3.37" RadiusX="0.85" RadiusY="0.85" />
    </GeometryGroup>

    <!-- 10.44 × 7.8, filled: three bulleted lines, for the list. -->
    <GeometryGroup x:Key="Icon.ViewList">
        <EllipseGeometry Center="0.8,0.8" RadiusX="0.8" RadiusY="0.8" />
        <EllipseGeometry Center="0.8,3.9" RadiusX="0.8" RadiusY="0.8" />
        <EllipseGeometry Center="0.8,7" RadiusX="0.8" RadiusY="0.8" />
        <RectangleGeometry Rect="2.77,0.225,7.67,1.15" RadiusX="0.575" RadiusY="0.575" />
        <RectangleGeometry Rect="2.77,3.325,7.67,1.15" RadiusX="0.575" RadiusY="0.575" />
        <RectangleGeometry Rect="2.77,6.425,7.67,1.15" RadiusX="0.575" RadiusY="0.575" />
    </GeometryGroup>

    <!-- 5.6 × 5.6 marks on the History window's own buttons: close, minimize and maximize. -->
    <Geometry x:Key="Icon.WindowClose">M 0.6,0.6 L 5,5 M 5,0.6 L 0.6,5</Geometry>
    <Geometry x:Key="Icon.WindowMinimize">M 0.3,2.8 H 5.3</Geometry>
    <Geometry x:Key="Icon.WindowMaximize">M 2.8,0.3 V 5.3 M 0.3,2.8 H 5.3</Geometry>

    <!-- The Visual Intelligence chips' glyphs (Controls/Capture.xaml), outline, drawn with a stroke of about 0.9. -->

    <!-- 9.6 × 7.8: a picture with a magnifying glass at its corner, for searching with an image. -->
    <Geometry x:Key="Icon.ImageSearch">
        M 6.75,0.5 H 1.5 A 1,1 0 0 0 0.5,1.5 V 5.6 A 1,1 0 0 0 1.5,6.6 H 3.4
        M 0.9,5.8 L 2.7,3.55 L 3.75,4.85
        M 2.25,2 A 0.45,0.45 0 1 1 2.24,2
        M 7.25,0.7 H 7.5 A 1,1 0 0 1 8.5,1.7 V 2.3
        M 8.55,5.1 A 1.5,1.5 0 1 1 5.55,5.1 A 1.5,1.5 0 1 1 8.55,5.1 Z
        M 8.1,6.15 L 9.1,7.15
    </Geometry>

    <!-- 6 × 6: a globe, for what goes out to the web. -->
    <Geometry x:Key="Icon.Globe">
        M 5.5,3 A 2.5,2.5 0 1 1 0.5,3 A 2.5,2.5 0 1 1 5.5,3 Z
        M 0.5,3 H 5.5
        M 3,0.5 C 1.9,1.5 1.9,4.5 3,5.5 M 3,0.5 C 4.1,1.5 4.1,4.5 3,5.5
    </Geometry>

    <!-- 16 × 15: a speech bubble with an exclamation mark, for "Report a Concern". -->
    <Geometry x:Key="Icon.ReportConcern">
        M 3,1 H 13 A 2,2 0 0 1 15,3 V 9 A 2,2 0 0 1 13,11 H 8.3 L 4.8,14 V 11 H 3 A 2,2 0 0 1 1,9 V 3 A 2,2 0 0 1 3,1 Z
        M 8,3.7 V 6.5 M 8,8.3 V 8.35
    </Geometry>

    <!-- 17.1 × 10.4: a keyboard, with two rows of keys and a space bar. -->
    <Geometry x:Key="Icon.Keyboard">
        M 2.525,0.625 H 14.575 A 1.9,1.9 0 0 1 16.475,2.525 V 7.875 A 1.9,1.9 0 0 1 14.575,9.775 H 2.525
        A 1.9,1.9 0 0 1 0.625,7.875 V 2.525 A 1.9,1.9 0 0 1 2.525,0.625 Z
        M 3.06,3.1 h 0.01 M 5.23,3.1 h 0.01 M 7.4,3.1 h 0.01 M 9.57,3.1 h 0.01 M 11.74,3.1 h 0.01 M 13.91,3.1 h 0.01
        M 3.06,5.3 h 0.01 M 5.23,5.3 h 0.01 M 7.4,5.3 h 0.01 M 9.57,5.3 h 0.01 M 11.74,5.3 h 0.01 M 13.91,5.3 h 0.01
        M 3.06,7.5 h 0.01 M 5.23,7.5 H 11.74 M 13.91,7.5 h 0.01
    </Geometry>

</ResourceDictionary>
