<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Assistant.UI.Controls"
                    xmlns:messages="clr-namespace:Assistant.UI.Messages"
                    xmlns:confirmation="clr-namespace:Assistant.Core.Confirmation;assembly=Assistant.Core"
                    mc:Ignorable="po">

    <!-- The question the Assistant asks before it changes anything (PROJECT_SPEC section 4.8, step 115): a dark gray panel in the conversation, as wide as a card
         but not one (it is a question, not a result), that says what would be done and to what, line by line, and asks Allow or Don't allow. It is made of the
         same parts as the approval panel of an integration, whose buttons it shares. Provisional until a reference shows one. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Tokens/Surfaces.xaml" />
        <ResourceDictionary Source="../Tokens/Strokes.xaml" />
        <ResourceDictionary Source="../Tokens/States.xaml" />
        <ResourceDictionary Source="../Tokens/Radii.xaml" />
        <ResourceDictionary Source="../Icons.xaml" />
        <ResourceDictionary Source="IconButton.xaml" />
        <ResourceDictionary Source="ImageSearch.xaml" />
        <ResourceDictionary Source="ActionCards.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="Confirm.Padding">16,14,16,16</Thickness>
    <Thickness x:Key="Confirm.LineMargin">0,10,0,0</Thickness>
    <sys:Double x:Key="Confirm.DetailsMaxHeight">260</sys:Double>
    <SolidColorBrush x:Key="Brush.Confirm.Allowed" Color="#5FD07A" po:Freeze="True" />

    <!-- Shown only while the question waits, and only once it has ended. -->
    <Style x:Key="Confirm.WhenWaiting" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Confirm.WhenFinished" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Confirm.WhenWarning" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The button that says yes, held back for a moment after the question appears. -->
    <Style x:Key="Confirm.Approve" TargetType="Button" BasedOn="{StaticResource ImageSearch.DialogPrimary}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- "Always allow": there only for a question that may be answered so (never one about a message), and held back with the button that says yes. -->
    <Style x:Key="Confirm.Always" TargetType="Button" BasedOn="{StaticResource ImageSearch.DialogButton}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanAlwaysAllow}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The words of a message in the question about sending it: they look as the message does, and can be written in. -->
    <Style x:Key="Confirm.MessageField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodySmall}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="SelectionBrush" Value="#7FB2FF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7,10,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="10" BorderBrush="{StaticResource Brush.State.FocusRing}" BorderThickness="1.5" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Confirm.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Confirm.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.BodySmall}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- One line of what is asked: what it is, and exactly what it is for this call. -->
    <DataTemplate x:Key="Confirm.Detail" DataType="{x:Type confirmation:ConfirmationDetail}">
        <StackPanel Margin="{StaticResource Confirm.LineMargin}">
            <TextBlock Style="{StaticResource Confirm.Label}" Text="{Binding Label}" />
            <TextBlock Style="{StaticResource Confirm.Value}" Text="{Binding Value}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type messages:ToolConfirmationContent}">
      <Grid>
        <Grid x:Name="General" Margin="{DynamicResource Message.CardBleed}" AutomationProperties.Name="{Binding Text}">
            <controls:PanelShape Fill="{StaticResource Brush.Surface.Code}" CornerSize="{StaticResource Radius.ContentBlock}" />
            <StackPanel Margin="{StaticResource Confirm.Padding}">

                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />

                <!-- What would be done, line by line. A long message scrolls here, so the buttons stay in view. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{StaticResource Confirm.DetailsMaxHeight}"
                              Focusable="False" IsTabStop="False">
                    <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource Confirm.Detail}" Focusable="False" IsTabStop="False" />
                </ScrollViewer>

                <Grid Style="{StaticResource Confirm.WhenWarning}" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource IconGlyph}" StrokeThickness="1.4" Data="{StaticResource Icon.Warning}" Stretch="None"
                          Stroke="{StaticResource Brush.Glyph.Warning}" VerticalAlignment="Top" Margin="0,2,9,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodySmall}" Text="{Binding Warning}" TextWrapping="Wrap" />
                </Grid>

                <!-- Waiting for the user's answer. -->
                <StackPanel Style="{StaticResource Confirm.WhenWaiting}" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource Confirm.Approve}" Padding="20,7,20,8" Command="{Binding ApproveCommand}" Content="{Binding ApproveLabel}"
                            AutomationProperties.Name="{Binding ApproveLabel}" />
                    <Button Style="{StaticResource Confirm.Always}" Padding="16,7,16,8" Margin="9,0,0,0" Command="{Binding AlwaysAllowCommand}" Content="Always allow"
                            ToolTip="Do it, and do not ask about this action again. You can change that in Settings, under Permissions."
                            AutomationProperties.Name="Always allow: do it, and do not ask about this action again" />
                    <Button Style="{StaticResource ImageSearch.DialogButton}" Padding="20,7,20,8" Margin="9,0,0,0" Command="{Binding DeclineCommand}" Content="{Binding DeclineLabel}"
                            AutomationProperties.Name="{Binding DeclineName}" />
                </StackPanel>

                <!-- Ended: how. -->
                <Grid Style="{StaticResource Confirm.WhenFinished}" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="ResultGlyph" Style="{StaticResource IconGlyph}" StrokeThickness="1.4" Data="{StaticResource Icon.Warning}" Stretch="None"
                          Stroke="{StaticResource Brush.Glyph.Warning}" VerticalAlignment="Top" Margin="0,2,9,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodySmall}" Text="{Binding ResultText}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- A message to send is asked about as the message itself (the message reference): "Ready to send it?" in the text column, and under it a plate
             with the person and the mark of the service it goes through, what the message says, whole, in a field of its own, and Cancel and Send side by
             side. Once the user says yes the whole question goes: the Assistant's words and the message as it went take its place. A no leaves one line. -->
        <StackPanel x:Name="AsMessage" Visibility="Collapsed" Margin="{DynamicResource Message.CardBleed}" AutomationProperties.Name="{Binding Text}">
            <StackPanel x:Name="MessageQuestion">
                <TextBlock Style="{StaticResource Text.Message}" Text="Ready to send it?" Margin="14,0,14,19.5" TextWrapping="Wrap" controls:Appear.Order="0" />
                <Grid controls:Appear.Order="1" ToolTip="{Binding MessageRoute}">
                    <Border Background="{StaticResource Brush.Action.Plate}" CornerRadius="26" />
                    <StackPanel Margin="16,16,16,16">
                        <ContentPresenter ContentTemplate="{StaticResource Message.Person}">
                            <ContentPresenter.Content>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <controls:ValuesConverter />
                                    </MultiBinding.Converter>
                                    <Binding Path="MessageInitials" />
                                    <Binding Path="MessageTo" />
                                    <Binding Path="MessageMarkBackground" />
                                    <Binding Path="MessageMarkGlyph" />
                                    <Binding Path="MessageChannel" />
                                </MultiBinding>
                            </ContentPresenter.Content>
                        </ContentPresenter>
                        <Border Margin="0,14,0,0" CornerRadius="11" Background="#33000000" BorderBrush="{StaticResource Brush.Stroke.ControlRim}" BorderThickness="1">
                            <Grid>
                                <ScrollViewer x:Name="MessageShown" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="150" Focusable="False" IsTabStop="False">
                                    <TextBlock Style="{StaticResource Text.MessageSmall}" Foreground="White" Margin="12,7,12,8" Text="{Binding MessageDraft}" TextWrapping="Wrap"
                                               AutomationProperties.Name="Message" />
                                </ScrollViewer>
                                <!-- While the question waits the words are the user's to change: a click puts the caret in them, and Send sends what stands there. -->
                                <TextBox x:Name="MessageField" Visibility="Collapsed" Style="{StaticResource Confirm.MessageField}" MaxHeight="150"
                                         Text="{Binding MessageDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MessageMaxLength}"
                                         ToolTip="Click to change the message before you send it" AutomationProperties.Name="Message, you can change it before you send it" />
                            </Grid>
                        </Border>
                        <Grid Style="{StaticResource Confirm.WhenWarning}" Margin="2,10,2,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Warning}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Style="{StaticResource Confirm.WhenWaiting}" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ImageSearch.DialogButton}" Padding="16,6,16,7" Command="{Binding DeclineCommand}" Content="Cancel"
                                    AutomationProperties.Name="Cancel: do not send the message" />
                            <Button Grid.Column="2" Style="{StaticResource Confirm.Approve}" Padding="16,6,16,7" Command="{Binding ApproveCommand}" Content="{Binding ApproveLabel}"
                                    AutomationProperties.Name="Send the message" />
                        </Grid>
                        <TextBlock Style="{StaticResource Confirm.WhenFinished}" Margin="2,12,2,0" Text="{Binding ResultText}" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Font.Text}" FontSize="{StaticResource FontSize.BodySmall}" Foreground="{StaticResource Brush.Action.Dim}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
      </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMessage}" Value="True">
                <Setter TargetName="General" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AsMessage" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding CanEditMessage}" Value="True" />
                    <Condition Binding="{Binding IsWaiting}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="MessageShown" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="MessageField" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsGone}" Value="True">
                <Setter TargetName="MessageQuestion" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAllowed}" Value="True">
                <Setter TargetName="ResultGlyph" Property="Data" Value="{StaticResource Icon.Check}" />
                <Setter TargetName="ResultGlyph" Property="Stroke" Value="{StaticResource Brush.Confirm.Allowed}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
