<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Assistant.UI.Controls"
                    mc:Ignorable="po">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Icons.xaml" />
        <ResourceDictionary Source="IconButton.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The Visual Intelligence overlay's chips (PROJECT_SPEC §4.6), measured from its reference, whose pixels are twice the
         DIPs here. The Ask chip is 146.5 × 27.5 and the others 20 high, 4.5 apart, with their words at 9.6 (a cap height of
         13 pixels at 2x, and "Image Search" 117 pixels wide in Segoe UI Variable), in the reference's medium weight, which is semibold. -->
    <sys:Double x:Key="Capture.AskWidth">146.5</sys:Double>
    <sys:Double x:Key="Capture.AskHeight">27.5</sys:Double>
    <sys:Double x:Key="Capture.ChipHeight">20</sys:Double>
    <sys:Double x:Key="Capture.ChipGap">4.5</sys:Double>
    <sys:Double x:Key="FontSize.CaptureChip">9.6</sys:Double>
    <Thickness x:Key="Capture.AskIconMargin">8.5,0,0,0</Thickness>
    <Thickness x:Key="Capture.AskTextMargin">21.5,0,10,0</Thickness>
    <Thickness x:Key="Capture.ChipPadding">7.5,0,10.5,0</Thickness>

    <!-- The glass: over the blurred snapshot, a white layer of about 5 % (the reference reads 134 where the dimmed screen is
         127), the light that runs in along the top and bottom edges (+13 at the very edge, gone in the first fifth) and the
         rim, which is 45 % white along the top and bottom, and 15 % at the sides. A one-pixel dark line lies just outside it. -->
    <SolidColorBrush x:Key="Brush.Capture.ChipTint" Color="#0DFFFFFF" po:Freeze="True" />
    <LinearGradientBrush x:Key="Brush.Capture.ChipEdgeLight" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#1AFFFFFF" />
        <GradientStop Offset="0.2" Color="#05FFFFFF" />
        <GradientStop Offset="0.8" Color="#05FFFFFF" />
        <GradientStop Offset="1" Color="#1FFFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Capture.ChipRim" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#73FFFFFF" />
        <GradientStop Offset="0.3" Color="#33FFFFFF" />
        <GradientStop Offset="0.5" Color="#26FFFFFF" />
        <GradientStop Offset="0.7" Color="#33FFFFFF" />
        <GradientStop Offset="1" Color="#73FFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Capture.ChipOuterLine" Color="#26000000" po:Freeze="True" />

    <!-- The Ask chip's caret is the reference's light blue. The words are white; the empty field's are the same, since the
         reference shows "Ask Siri" as bright as "Image Search". -->
    <SolidColorBrush x:Key="Brush.Capture.Caret" Color="#8CA8DC" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Capture.ChipText" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Capture.ChipHover" Color="#1AFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Capture.ChipPressed" Color="#0DFFFFFF" po:Freeze="True" />

    <!-- A pill of frosted glass: its backdrop is clipped to the pill by the control, and its rim drawn inside its edge. -->
    <Style TargetType="controls:FrostedPill">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:FrostedPill">
                    <Grid SnapsToDevicePixels="False">
                        <!-- Just outside the rim, a faint dark line that sets the glass off from a bright page. -->
                        <controls:PillShape Margin="-1" Stroke="{StaticResource Brush.Capture.ChipOuterLine}" StrokeThickness="0.5" />
                        <Grid x:Name="PART_Backdrop">
                            <Rectangle x:Name="PART_Blur" Margin="-10">
                                <Rectangle.Effect>
                                    <BlurEffect Radius="3" KernelType="Gaussian" RenderingBias="Quality" />
                                </Rectangle.Effect>
                            </Rectangle>
                            <Rectangle Fill="{StaticResource Brush.Capture.ChipTint}" />
                            <Rectangle Fill="{StaticResource Brush.Capture.ChipEdgeLight}" />
                        </Grid>
                        <controls:PillShape Stroke="{StaticResource Brush.Capture.ChipRim}" StrokeThickness="1" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Capture.ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.CaptureChip}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Capture.ChipText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- The glyphs on the chips, in the chips' white, with a fine stroke. -->
    <Style x:Key="Capture.ChipGlyph" TargetType="Path" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="Stroke" Value="{StaticResource Brush.Capture.ChipText}" />
        <Setter Property="StrokeThickness" Value="0.9" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A chip that does something when pressed: glass that lightens under the pointer and dims a little when pressed. -->
    <Style x:Key="Capture.ChipButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Capture.ChipHeight}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="{StaticResource Capture.ChipPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Chip">
                        <controls:FrostedPill x:Name="Glass" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Grid>
                                <controls:PillShape x:Name="StateLayer" Fill="Transparent" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </controls:FrostedPill>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.Capture.ChipHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.Capture.ChipPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chip" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
