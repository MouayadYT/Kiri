<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Assistant.UI.Controls">

    <!-- The tokens, glyph style and glass these styles use. StaticResource cannot see sibling dictionaries in
         Theme.xaml, so each control dictionary merges the dictionaries it needs. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Tokens/Surfaces.xaml" />
        <ResourceDictionary Source="../Tokens/Strokes.xaml" />
        <ResourceDictionary Source="IconButton.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The launcher's rows, measured from its reference in DIPs, from the panel's left edge: each row is 48 tall and
         fills the panel's width. Its glyph is centered 44 in, in a column 24 wide, its words begin 81.3 in, and the keys
         that run it begin 459 in, the modifier's glyph then the key 3.2 after it. The highlighted row is a pill 12 in from
         each side. The insets lift the words and the key onto the reference's baseline. -->
    <sys:Double x:Key="CommandItem.Height">48</sys:Double>
    <Thickness x:Key="CommandItem.HighlightMargin">12,0,12,0</Thickness>
    <Thickness x:Key="CommandItem.ContentMargin">32,0,37,0</Thickness>
    <GridLength x:Key="CommandItem.GlyphWidth">24</GridLength>
    <Thickness x:Key="CommandItem.TitleMargin">25.3,0,0,0</Thickness>
    <Thickness x:Key="CommandItem.TitleInset">0,0,0,4.7</Thickness>
    <GridLength x:Key="CommandItem.HintWidth">24</GridLength>
    <Thickness x:Key="CommandItem.HintKeyMargin">3.2,0,0,0</Thickness>
    <Thickness x:Key="CommandItem.HintKeyInset">0,0,0,3.5</Thickness>
    <Thickness x:Key="CommandItem.HintModifierMargin">0,0,0,1.8</Thickness>

    <!-- The launcher's glyphs, drawn from the reference at its size and with its strokes: white outlines with round
         ends, in the row's text color. A command's IconKey names one of these. -->

    <!-- 22.5 x 20.2: Applications. The stick that leans left and forks at its top, the one that leans right, and the
         bar across, cut short where the right stick passes, with a small dash under its left end. -->
    <DataTemplate x:Key="Glyph.Applications">
        <Grid Width="22.5" Height="20.2">
            <Path Style="{StaticResource IconGlyph}" StrokeThickness="2.8"
                  Data="M 13.23,1.43 L 6.05,14 M 9.4,1.43 L 11.5,5.2" />
            <Path Style="{StaticResource IconGlyph}" StrokeThickness="2.6" Data="M 13,6.8 L 19.17,18.83" />
            <Path Style="{StaticResource IconGlyph}" StrokeThickness="2.8" StrokeEndLineCap="Flat"
                  Data="M 1.4,14 H 13.83" />
            <Path Style="{StaticResource IconGlyph}" StrokeThickness="2.8" Data="M 15.9,14 H 21.1" />
            <Path Style="{StaticResource IconGlyph}" StrokeThickness="2.8" Data="M 3.4,18.7 L 4.2,17.6" />
        </Grid>
    </DataTemplate>

    <!-- 22 x 17.5: Files. A folder with a small tab, and a line under its top edge. -->
    <DataTemplate x:Key="Glyph.Files">
        <Path Style="{StaticResource IconGlyph}" StrokeThickness="1.45" Width="22" Height="17.5"
              Data="M 0.9,3.6 A 2.7,2.7 0 0 1 3.6,0.9 H 5.9 C 7.5,0.9 8,2.3 9.6,2.3 H 18.5 A 2.6,2.6 0 0 1 21.1,4.9
                    V 14 A 2.6,2.6 0 0 1 18.5,16.6 H 3.5 A 2.6,2.6 0 0 1 0.9,14 Z
                    M 2.9,5.4 H 19.1" />
    </DataTemplate>

    <!-- 19.8 x 22.7: Actions. Two stacked, rounded diamonds; the lower one shows only below the upper one. -->
    <DataTemplate x:Key="Glyph.Actions">
        <Path Style="{StaticResource IconGlyph}" StrokeThickness="1.45" Width="19.8" Height="22.7"
              Data="M 7.48,1.77 C 8.82,0.79 10.98,0.79 12.32,1.77 L 17.88,5.83 C 19.22,6.81 19.22,8.39 17.88,9.37
                    L 12.32,13.43 C 10.98,14.41 8.82,14.41 7.48,13.43 L 1.92,9.37 C 0.58,8.39 0.58,6.81 1.92,5.83 Z
                    M 4.28,12 L 1.89,13.75 C 0.57,14.72 0.57,16.28 1.89,17.25 L 7.48,21.33 C 8.82,22.31 10.98,22.31 12.32,21.33
                    L 17.91,17.25 C 19.23,16.28 19.23,14.72 17.91,13.75 L 15.52,12" />
    </DataTemplate>

    <!-- 19.2 x 23.9: Clipboard. Two pages with folded corners, the front one over the back one. -->
    <DataTemplate x:Key="Glyph.Clipboard">
        <Path Style="{StaticResource IconGlyph}" StrokeThickness="1.45" Width="19.2" Height="23.9"
              Data="M 0.93,8.83 C 0.93,7.08 2.35,5.67 4.1,5.67 L 7.27,5.67 L 14,12.27 L 14,19.8
                    C 14,21.57 12.57,23 10.8,23 L 4.13,23 C 2.37,23 0.93,21.57 0.93,19.8 Z
                    M 7.27,5.67 V 11.2 Q 7.27,12.27 8.34,12.27 H 14
                    M 5.5,5.67 L 5.5,3.22 C 5.5,1.86 6.6,0.77 7.95,0.77 L 12.4,0.77 L 18.4,6.93 L 18.4,16.15
                    C 18.4,17.13 17.6,17.93 16.62,17.93 L 14.83,17.93
                    M 12.4,0.77 V 5.86 Q 12.4,6.93 13.47,6.93 H 18.4" />
    </DataTemplate>

    <!-- 12.5 x 12.5: the Command key's symbol, which the reference draws before the key on each row's hint: a small
         square whose corners run out into four loops. -->
    <DataTemplate x:Key="Glyph.CommandKey">
        <Path Style="{StaticResource IconGlyph}" StrokeThickness="1.4" Width="12.5" Height="12.5"
              Data="M 0.8,2.9 A 2.1,2.1 0 1 1 5,2.9 A 2.1,2.1 0 1 1 0.8,2.9 Z
                    M 7.5,2.9 A 2.1,2.1 0 1 1 11.7,2.9 A 2.1,2.1 0 1 1 7.5,2.9 Z
                    M 0.8,9.6 A 2.1,2.1 0 1 1 5,9.6 A 2.1,2.1 0 1 1 0.8,9.6 Z
                    M 7.5,9.6 A 2.1,2.1 0 1 1 11.7,9.6 A 2.1,2.1 0 1 1 7.5,9.6 Z
                    M 4.6,4.1 V 8.4 M 7.9,4.1 V 8.4 M 4.1,4.6 H 8.4 M 4.1,7.9 H 8.4" />
    </DataTemplate>

    <!-- One of the launcher's rows: its glyph, its title and the keys that run it. The highlighted row, which the arrow
         keys move, and the one under the pointer are lit by a pill of white. Clicking the row runs its command. A row is
         never focused: the bar's editor keeps the keyboard. -->
    <Style x:Key="CommandItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="{StaticResource CommandItem.Height}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="AutomationProperties.AcceleratorKey" Value="{Binding ShortcutText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding Command}" />
                        </Grid.InputBindings>
                        <controls:PillShape x:Name="Highlight" Margin="{StaticResource CommandItem.HighlightMargin}" />
                        <Grid Margin="{StaticResource CommandItem.ContentMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource CommandItem.GlyphWidth}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource CommandItem.HintWidth}" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource Brush.Text.CommandItem}"
                                              Content="{Binding}"
                                              ContentTemplate="{Binding IconKey, Converter={x:Static controls:GlyphTemplateConverter.Instance}}" />
                            <TextBlock x:Name="Title" Grid.Column="1" Margin="{StaticResource CommandItem.TitleMargin}"
                                       VerticalAlignment="Center" Padding="{StaticResource CommandItem.TitleInset}"
                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource Font.Text}"
                                       FontSize="{StaticResource FontSize.CommandItem}" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.CommandItem}" />
                            <StackPanel x:Name="Hint" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                <ContentPresenter x:Name="HintModifier" VerticalAlignment="Center"
                                                  Margin="{StaticResource CommandItem.HintModifierMargin}"
                                                  TextElement.Foreground="{StaticResource Brush.Text.CommandHint}"
                                                  Content="{Binding Hint}"
                                                  ContentTemplate="{Binding DataContext.Hint.ModifierGlyphKey, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={x:Static controls:GlyphTemplateConverter.Instance}}" />
                                <TextBlock x:Name="HintKey" Margin="{StaticResource CommandItem.HintKeyMargin}"
                                           VerticalAlignment="Center" Padding="{StaticResource CommandItem.HintKeyInset}"
                                           Text="{Binding Hint.Key}"
                                           FontFamily="{StaticResource Font.Text}"
                                           FontSize="{StaticResource FontSize.CommandHint}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.CommandHint}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Fill" Value="{StaticResource Brush.Surface.CommandItemHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Highlight" Property="Fill" Value="{StaticResource Brush.Surface.CommandItemSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list of command rows with no chrome of its own: no scroll bar, no border and no focus, so the bar's editor
         keeps the keyboard while the rows are moved through with the arrow keys. -->
    <Style x:Key="CommandList" TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CommandItem}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
