<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Assistant.UI.Controls"
                    xmlns:core="clr-namespace:Assistant.Core.ModelProfiles;assembly=Assistant.Core"
                    xmlns:settings="clr-namespace:Assistant.UI.Settings"
                    mc:Ignorable="po">

    <!-- The tokens, glyphs and styles these styles use. StaticResource cannot see sibling dictionaries in Theme.xaml,
         so each control dictionary merges the dictionaries it needs. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Tokens/Surfaces.xaml" />
        <ResourceDictionary Source="../Tokens/Strokes.xaml" />
        <ResourceDictionary Source="../Tokens/States.xaml" />
        <ResourceDictionary Source="../Tokens/Radii.xaml" />
        <ResourceDictionary Source="../Tokens/Shadows.xaml" />
        <ResourceDictionary Source="../Icons.xaml" />
        <ResourceDictionary Source="IconButton.xaml" />
        <ResourceDictionary Source="Menu.xaml" />
        <ResourceDictionary Source="History.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The Settings window (Views/SettingsWindow) is built from the History window's own surfaces: the same Mica frame,
         the same sidebar and workspace layers, the same window buttons, cards and rows, and the same glass buttons. No
         reference shows a settings window, so its measurements are chosen to sit with those. The sidebar is 240 wide with
         its list under the 48-tall band that moves the window; the page is a column 620 wide, centered, its title 58 below
         the window's top. A group is a card of the History window's card glass, its rows 54 tall or more with the text
         18 from its edge, and a hairline between them. -->
    <GridLength x:Key="Settings.SidebarWidth">240</GridLength>
    <Thickness x:Key="Settings.NavPadding">10,56,10,16</Thickness>
    <sys:Double x:Key="Settings.NavItemHeight">34</sys:Double>
    <Thickness x:Key="Settings.NavItemPadding">12,0,8,1</Thickness>
    <sys:Double x:Key="Settings.PageWidth">620</sys:Double>
    <Thickness x:Key="Settings.PageMargin">40,56,40,40</Thickness>
    <sys:Double x:Key="Settings.CardCorner">22</sys:Double>
    <sys:Double x:Key="Settings.FieldCorner">10</sys:Double>
    <sys:Double x:Key="Settings.ControlHeight">30</sys:Double>
    <sys:Double x:Key="Settings.RowMinHeight">54</sys:Double>
    <Thickness x:Key="Settings.RowPadding">18,10,16,10</Thickness>
    <Thickness x:Key="Settings.SeparatorMargin">18,0,18,0</Thickness>
    <sys:Double x:Key="Settings.TitleSize">26</sys:Double>
    <PointCollection x:Key="Settings.TopFade">6,0 20,0.45 38,1</PointCollection>
    <PointCollection x:Key="Settings.BottomFade">0,0 18,1</PointCollection>

    <!-- The colors: the History window's blue for what is on or chosen, white layers for what is off, and warm and red
         hues for advice, which are the only colors that are not neutral glass. Descriptions are 60 % white, dimmer than the
         titles but still readable on the darkest layer. -->
    <SolidColorBrush x:Key="Brush.Settings.ToggleOn" Color="#2F6BD5" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Settings.ToggleOff" Color="#40FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Settings.Thumb" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Settings.Description" Color="#99FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Settings.Warning" Color="#F2B84B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Settings.Error" Color="#FF7B72" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Settings.Recording" Color="#802F6BD5" po:Freeze="True" />
    <BooleanToVisibilityConverter x:Key="Settings.ShowWhenTrue" />

    <!-- The page's title and a group's header. -->
    <Style x:Key="Text.SettingsTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Settings.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Message}" />
    </Style>

    <Style x:Key="Text.SettingsGroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.HistorySection}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.HistorySection}" />
    </Style>

    <Style x:Key="Text.SettingsHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodySmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Message}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.SettingsDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Settings.Description}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="Text.SettingsPath" TargetType="TextBlock" BasedOn="{StaticResource Text.SettingsDescription}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Code}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Advice about what was typed, in the row's footer: quiet for a note, warm for a warning that may cost memory, red
         for a number that cannot be used. -->
    <DataTemplate DataType="{x:Type settings:NumberField}">
        <TextBlock x:Name="Advice" Text="{Binding AdviceText}" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.SettingsDescription}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Settings.Description}" />
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasAdvice}" Value="True">
                <Setter TargetName="Advice" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AdviceLevel}" Value="{x:Static core:ContextAdviceLevel.Warning}">
                <Setter TargetName="Advice" Property="Foreground" Value="{StaticResource Brush.Settings.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AdviceLevel}" Value="{x:Static core:ContextAdviceLevel.Error}">
                <Setter TargetName="Advice" Property="Foreground" Value="{StaticResource Brush.Settings.Error}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A group: its header over a card of glass that holds its rows. -->
    <Style x:Key="SettingsGroup" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,26" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <TextBlock x:Name="Header" Style="{StaticResource Text.SettingsGroupHeader}" Text="{TemplateBinding Header}"
                                   Margin="8,0,0,8" />
                        <Grid>
                            <controls:PanelShape Fill="{StaticResource Brush.Surface.HistoryCard}"
                                                 Stroke="{StaticResource Brush.Stroke.HistoryCardRim}"
                                                 StrokeThickness="{StaticResource StrokeThickness.Hairline}"
                                                 CornerSize="{StaticResource Settings.CardCorner}" />
                            <ContentPresenter />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The hairline between two rows of a group. -->
    <Style x:Key="SettingsSeparator" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="{StaticResource Settings.SeparatorMargin}" />
        <Setter Property="Fill" Value="{StaticResource Brush.Stroke.Separator}" />
    </Style>

    <!-- A row: its title and sentence at the left, its control at the right, its footer across the bottom. A setting that
         cannot be changed yet is dimmed, its control disabled, and it says so beside its title. -->
    <Style TargetType="controls:SettingsRow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsRow">
                    <Grid MinHeight="{StaticResource Settings.RowMinHeight}" Margin="{StaticResource Settings.RowPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="Texts" VerticalAlignment="Center">
                            <WrapPanel>
                                <TextBlock x:Name="Header" Style="{StaticResource Text.SettingsHeader}" Text="{TemplateBinding Header}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border x:Name="Badge" Visibility="Collapsed" Margin="0,1,0,0" Padding="8,2,8,3"
                                        Background="{StaticResource Brush.Surface.Bubble}" CornerRadius="9"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="BadgeText" Text="{TemplateBinding StatusText}"
                                               FontFamily="{StaticResource Font.Text}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Settings.Description}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="Description" Style="{StaticResource Text.SettingsDescription}"
                                       Text="{TemplateBinding Description}" Margin="0,2,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ContentPresenter x:Name="Control" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MaxWidth="400"
                                          IsEnabled="{TemplateBinding IsControlEnabled}" />
                        <ContentPresenter x:Name="Footer" Grid.Row="2" Grid.ColumnSpan="2" Content="{TemplateBinding Footer}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDescription" Value="True">
                            <Setter TargetName="Description" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Layout" Value="Stacked">
                            <Setter TargetName="Control" Property="Grid.Column" Value="0" />
                            <Setter TargetName="Control" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Control" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="Control" Property="Margin" Value="0,10,0,0" />
                            <Setter TargetName="Control" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                        <Trigger Property="Status" Value="ComingLater">
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Header" Property="Opacity" Value="0.6" />
                            <Setter TargetName="Description" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="Status" Value="NotInThisVersion">
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Header" Property="Opacity" Value="0.6" />
                            <Setter TargetName="Description" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="Status" Value="AlwaysOff">
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Header" Property="Opacity" Value="0.6" />
                            <Setter TargetName="Description" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="Status" Value="AtNextStart">
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Status" Value="AtNextModelLoad">
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A switch: a pill that is the History window's blue when on and a white layer when off, with a white knob. -->
    <Style x:Key="SettingsToggle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="42" Height="24" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="12" Background="{StaticResource Brush.Settings.ToggleOff}" />
                        <Border x:Name="StateLayer" CornerRadius="12" Background="Transparent" />
                        <Ellipse x:Name="Knob" Width="20" Height="20" Margin="2" HorizontalAlignment="Left"
                                 Fill="{StaticResource Brush.Settings.Thumb}" />
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="15" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderBrush="{StaticResource Brush.State.FocusRing}"
                                BorderThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Settings.ToggleOn}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Background" Value="{StaticResource Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.State.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A field for text or a number: the glass of the History window's buttons with its rim, a ring in the focus color
         while typing, and a red one when what is typed cannot be saved. -->
    <Style x:Key="SettingsTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource Settings.ControlHeight}" />
        <Setter Property="Width" Value="140" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodySmall}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Message}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Message}" />
        <Setter Property="Padding" Value="11,0,11,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <controls:PanelShape Fill="{StaticResource Brush.Control.Glass}"
                                             Stroke="{StaticResource Brush.Stroke.ControlRim}"
                                             StrokeThickness="{StaticResource StrokeThickness.Hairline}"
                                             CornerSize="{StaticResource Settings.FieldCorner}" />
                        <controls:PanelShape x:Name="Ring" Stroke="{StaticResource Brush.State.FocusRing}" Visibility="Collapsed"
                                             StrokeThickness="{StaticResource StrokeThickness.FocusRing}"
                                             CornerSize="{StaticResource Settings.FieldCorner}" />
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                      VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="controls:SettingsField.IsInvalid" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Settings.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.State.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button of glass, a pill of the History window's own glass with a white state layer. -->
    <Style x:Key="SettingsButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Settings.ControlHeight}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="14,0,14,1" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodySmall}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Message}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <controls:PanelShape x:Name="Surface" Fill="{StaticResource Brush.Control.Glass}"
                                             Stroke="{StaticResource Brush.Stroke.ControlRim}"
                                             StrokeThickness="{StaticResource StrokeThickness.Hairline}"
                                             CornerSize="{StaticResource Settings.FieldCorner}" />
                        <controls:PanelShape x:Name="StateLayer" CornerSize="{StaticResource Settings.FieldCorner}" />
                        <controls:PanelShape x:Name="Ring" Stroke="{StaticResource Brush.State.FocusRing}" Visibility="Collapsed"
                                             StrokeThickness="{StaticResource StrokeThickness.FocusRing}"
                                             CornerSize="{StaticResource Settings.FieldCorner}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.State.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The button that shows a shortcut's keys and records new ones when pressed: it lights in the blue while it waits. -->
    <Style x:Key="SettingsKeycap" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Settings.Recording}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A choice from a short list: the same glass as the fields, a chevron at its right, and, when open, a menu of the
         History window's menu glass under it. -->
    <Style x:Key="SettingsComboItem" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="{StaticResource Menu.ItemHeight}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Menu}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent" MinHeight="26">
                        <controls:PanelShape x:Name="Highlight" Margin="5,0,5,0" CornerSize="{StaticResource Radius.MenuItem}" />
                        <Path x:Name="Check" Style="{StaticResource IconGlyph}" StrokeThickness="1.9"
                              Data="{StaticResource Icon.MenuCheck}" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="13,0.9,0,0" Visibility="Hidden" />
                        <ContentPresenter Margin="34,0,16,1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Highlight" Property="Fill" Value="{StaticResource Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.State.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource Settings.ControlHeight}" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodySmall}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Message}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <controls:PanelShape Fill="{StaticResource Brush.Control.Glass}"
                                                             Stroke="{StaticResource Brush.Stroke.ControlRim}"
                                                             StrokeThickness="{StaticResource StrokeThickness.Hairline}"
                                                             CornerSize="{StaticResource Settings.FieldCorner}" />
                                        <controls:PanelShape x:Name="StateLayer" CornerSize="{StaticResource Settings.FieldCorner}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.State.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.State.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <controls:PanelShape x:Name="Ring" Stroke="{StaticResource Brush.State.FocusRing}" Visibility="Collapsed"
                                             StrokeThickness="{StaticResource StrokeThickness.FocusRing}"
                                             CornerSize="{StaticResource Settings.FieldCorner}" IsHitTestVisible="False" />
                        <ContentPresenter Margin="12,0,34,1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Path Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="{StaticResource Brush.Text.Message}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,13,0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None" StaysOpen="False"
                               MinWidth="{Binding ActualWidth, ElementName=Root}">
                            <Grid Margin="{StaticResource Menu.ShadowRoom}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Grid controls:OutsideClip.CornerSize="{StaticResource Radius.Menu}" IsHitTestVisible="False">
                                    <controls:PanelShape Fill="{StaticResource Brush.Shadow.Caster}"
                                                         Margin="{StaticResource Shadow.CasterInset}"
                                                         CornerSize="{StaticResource Radius.Menu}"
                                                         Effect="{StaticResource Shadow.Menu}" />
                                </Grid>
                                <controls:PanelShape Fill="{StaticResource Brush.Surface.MenuOpaque}" CornerSize="{StaticResource Radius.Menu}" />
                                <controls:PanelShape Margin="{StaticResource Menu.RimInset}" Stroke="{StaticResource Brush.Stroke.MenuRim}"
                                                     StrokeThickness="{StaticResource StrokeThickness.Hairline}"
                                                     CornerSize="{StaticResource Radius.Menu}" />
                                <controls:PanelShape Stroke="{StaticResource Brush.Stroke.MenuOutline}"
                                                     StrokeThickness="{StaticResource StrokeThickness.MenuOutline}"
                                                     CornerSize="{StaticResource Radius.Menu}" />
                                <ScrollViewer Margin="{StaticResource Menu.Padding}" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.State.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The sidebar's list of sections: rows with nothing of their own on the sidebar, a faint layer while hovered and the
         History window's selected-row layer for the open one, with smooth corners. -->
    <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{StaticResource Settings.NavItemHeight}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HistoryRowFocusVisual}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <controls:PanelShape x:Name="StateLayer" CornerSize="{StaticResource Radius.HistoryRow}" />
                        <ContentPresenter Margin="{StaticResource Settings.NavItemPadding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.Surface.HistoryRowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.Surface.HistoryRowSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsNavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Settings.NavPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavItem}" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Text}"
                               FontSize="{StaticResource FontSize.BodySmall}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Message}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A model profile in the list: a card of the History window's card glass, ringed in its blue while it is the one
         chosen, with the keyboard's ring on a card it reaches without choosing it. -->
    <Style x:Key="SettingsProfileItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <controls:PanelShape x:Name="Surface" Fill="{StaticResource Brush.Surface.HistoryCard}"
                                             Stroke="{StaticResource Brush.Stroke.HistoryCardRim}"
                                             StrokeThickness="{StaticResource StrokeThickness.Hairline}"
                                             CornerSize="{StaticResource Settings.CardCorner}" />
                        <controls:PanelShape x:Name="StateLayer" CornerSize="{StaticResource Settings.CardCorner}" />
                        <ContentPresenter />
                        <controls:PanelShape x:Name="SelectedOutline" Visibility="Collapsed" IsHitTestVisible="False"
                                             Margin="{StaticResource History.CardRingMargin}"
                                             Stroke="{StaticResource Brush.Stroke.HistoryCardSelected}"
                                             StrokeThickness="{StaticResource StrokeThickness.HistoryCardSelected}"
                                             CornerSize="{StaticResource Settings.CardCorner}" />
                        <controls:PanelShape x:Name="FocusRing" Visibility="Collapsed" IsHitTestVisible="False"
                                             Margin="{StaticResource History.CardRingMargin}"
                                             Stroke="{StaticResource Brush.State.FocusRing}"
                                             StrokeThickness="{StaticResource StrokeThickness.HistoryCardSelected}"
                                             CornerSize="{StaticResource Settings.CardCorner}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.Surface.HistoryCardHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.Surface.HistoryCardSelected}" />
                            <Setter TargetName="SelectedOutline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsProfileList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsProfileItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
