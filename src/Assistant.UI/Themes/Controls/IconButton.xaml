<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The tokens these styles use. StaticResource cannot see sibling dictionaries in Theme.xaml, so each
         control dictionary merges the token dictionaries it needs. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Tokens/Spacing.xaml" />
        <ResourceDictionary Source="../Tokens/Strokes.xaml" />
        <ResourceDictionary Source="../Tokens/States.xaml" />
        <ResourceDictionary Source="../Tokens/Surfaces.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- An outline glyph from Icons.xaml. It strokes with the inherited foreground, so a glyph inside a button
         follows the button's Foreground. -->
    <Style x:Key="IconGlyph" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="StrokeThickness" Value="{StaticResource StrokeThickness.Glyph}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- Keyboard focus ring for circular controls, just outside the circle. -->
    <Style x:Key="FocusVisual.Circle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="-3" Stroke="{StaticResource Brush.State.FocusRing}"
                             StrokeThickness="{StaticResource StrokeThickness.FocusRing}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round button that holds one glyph. It is transparent at rest and shows a white state layer on hover and
         press; a BorderBrush adds a hairline rim. Give each use an AutomationProperties.Name. -->
    <Style x:Key="CircularIconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Height" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Circle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{StaticResource StrokeThickness.Hairline}" />
                        <Ellipse x:Name="StateLayer" Fill="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="{StaticResource Brush.State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.State.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A larger round button of translucent glass with a white glyph, as on the floating conversation panel: it lifts
         dark glass and dims bright glass, such as the voice glow. A glass button without a command is decorative
         until its feature exists: it keeps its look but is disabled, so it is neither clickable nor a tab stop. -->
    <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource CircularIconButton}">
        <Setter Property="Width" Value="{StaticResource Size.GlassButton}" />
        <Setter Property="Height" Value="{StaticResource Size.GlassButton}" />
        <Setter Property="Background" Value="{StaticResource Brush.Control.Glass}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.ControlRim}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Glyph.OnGlass}" />
        <Style.Triggers>
            <Trigger Property="Command" Value="{x:Null}">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A glass button that opens its ContextMenu, which it shows lighter while the menu is open. Only its command
         opens the menu: a right-click does not. -->
    <Style x:Key="GlassMenuButton" TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
        <Setter Property="ContextMenuService.IsEnabled" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Control.GlassOpen}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
