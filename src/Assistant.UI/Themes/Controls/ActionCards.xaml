<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Assistant.UI.Controls"
                    xmlns:messages="clr-namespace:Assistant.UI.Messages"
                    mc:Ignorable="po">

    <!-- What the Assistant did, shown as the thing itself (the home and message references, 2x recordings, in DIPs): a device of the user's home as a row
         with its glyph, its name and what it is now, and a message that was sent as the person, the service it went through and the bubble it is in their
         chat. Both lie on a plate a little lighter than the panel, as wide as a card. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Tokens/Surfaces.xaml" />
        <ResourceDictionary Source="../Tokens/Strokes.xaml" />
        <ResourceDictionary Source="../Tokens/States.xaml" />
        <ResourceDictionary Source="../Tokens/Radii.xaml" />
        <ResourceDictionary Source="../Icons.xaml" />
        <ResourceDictionary Source="IconButton.xaml" />
        <ResourceDictionary Source="ResultContent.xaml" />
        <ResourceDictionary Source="AgentTask.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Action.Plate" Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Action.PlateHover" Color="#1CFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Action.Disc" Color="#8A000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Action.DiscOn" Color="#F2FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Action.Dim" Color="#99FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Action.Bubble" Color="#0A7CFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Action.Avatar" Color="#33FFFFFF" po:Freeze="True" />

    <!-- The home reference: the row is 65 tall with fully round ends; the glyph's disc is 32 across, 15.5 in from the row's left, and the name starts 50
         in; the name is semibold, what the device is now is under it, dimmer. -->
    <sys:Double x:Key="HomeDevice.RowHeight">65</sys:Double>
    <sys:Double x:Key="HomeDevice.DiscSize">32</sys:Double>

    <BooleanToVisibilityConverter x:Key="Action.ShowWhenTrue" />

    <!-- The device's glyph in its disc: pressing it switches the device. It is lit while the device is on, and dims while Home Assistant is being told. -->
    <Style x:Key="HomeDevice.Disc" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource HomeDevice.DiscSize}" />
        <Setter Property="Height" Value="{StaticResource HomeDevice.DiscSize}" />
        <Setter Property="Background" Value="{StaticResource Brush.Action.Disc}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Circle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" />
                        <Ellipse x:Name="StateLayer" Fill="Transparent" />
                        <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Data="{Binding Icon}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource Brush.Action.DiscOn}" />
                            <Setter Property="Foreground" Value="#1C1C1E" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Fill" Value="#38FFFFFF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CanToggle}" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The row itself is a button: pressing it anywhere but on the glyph opens what the Assistant did. It draws nothing of its own but the plate. -->
    <Style x:Key="HomeDevice.RowButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Action.Plate}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="32.5" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource Brush.Action.PlateHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The row of a device: shared by the card in the conversation and by the pill the window shows it alone in. -->
    <DataTemplate x:Key="HomeDevice.Row" DataType="{x:Type messages:HomeDeviceContent}">
        <Grid Height="{StaticResource HomeDevice.RowHeight}" AutomationProperties.Name="{Binding Text}">
            <Button x:Name="Open" Style="{StaticResource HomeDevice.RowButton}" Command="{Binding OpenCommand}"
                    AutomationProperties.Name="{Binding Name, StringFormat='Show what was done to {0}'}">
                <StackPanel Margin="66,0,20,1" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="White" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="State" Style="{StaticResource Text.BodySmall}" Foreground="{StaticResource Brush.Action.Dim}" Margin="0,1,0,0"
                               Text="{Binding StateText}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Button>
            <Button x:Name="Toggle" Style="{StaticResource HomeDevice.Disc}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15.5,0,0,0"
                    Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding ToggleName}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                <Setter TargetName="State" Property="Text" Value="{Binding Problem}" />
                <Setter TargetName="State" Property="Foreground" Value="{StaticResource Brush.Glyph.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- In the conversation: the row, and under it, once it is pressed, what the Assistant did step by step. -->
    <DataTemplate DataType="{x:Type messages:HomeDeviceContent}">
        <StackPanel Margin="{DynamicResource Message.CardBleed}" controls:Appear.Order="0">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HomeDevice.Row}" />
            <Grid Margin="0,8,0,0" Visibility="{Binding ShowsSteps, Converter={StaticResource Action.ShowWhenTrue}}">
                <Border Background="{StaticResource Brush.Action.Plate}" CornerRadius="22" />
                <StackPanel Margin="18,6,18,16">
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" IsTabStop="False" AutomationProperties.Name="What was done" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- The person a message is for or went to (the message reference): a disc 52 across where their picture would be, with the first letters of their
         name, the mark of the service at its lower right (18 across, with a rim of the plate's own dark so it reads over the disc), and beside it the
         name, semibold, over the service's name, dimmer. -->
    <DataTemplate x:Key="Message.Person">
        <Grid Height="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid Width="52" Height="52" IsHitTestVisible="False">
                <Ellipse Fill="{StaticResource Brush.Action.Avatar}" />
                <TextBlock Text="{Binding [0]}" FontFamily="{StaticResource Font.Text}" FontSize="19" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                <Grid Width="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1">
                    <Border CornerRadius="6" Background="#1C1C1E" />
                    <Border CornerRadius="5" Margin="1.25" Background="{Binding [2]}" />
                    <Viewbox Width="11.5" Height="11.5">
                        <Path Width="16" Height="16" Data="{Binding [3]}" Fill="White" />
                    </Viewbox>
                </Grid>
            </Grid>
            <StackPanel Grid.Column="1" Margin="17,0,0,2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="White" Text="{Binding [1]}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Text.BodySmall}" Foreground="{StaticResource Brush.Action.Dim}" Margin="0,1,0,0" Text="{Binding [4]}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- A message that was sent: the person, and what was sent as the bubble it is in their chat, at the right, with its tail. The button that
         copies what was sent is the answer's own, under it (Messages.xaml), where the reference has its share and more buttons. The plate comes in out of
         a blur after the Assistant's words. -->
    <DataTemplate DataType="{x:Type messages:SentMessageContent}">
        <StackPanel Margin="{DynamicResource Message.CardBleed}" AutomationProperties.Name="{Binding Text}">
            <Grid controls:Appear.Order="1">
                <Border Background="{StaticResource Brush.Action.Plate}" CornerRadius="26" />
                <StackPanel Margin="16,16,16,22">
                    <ContentPresenter ContentTemplate="{StaticResource Message.Person}">
                        <ContentPresenter.Content>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <controls:ValuesConverter />
                                </MultiBinding.Converter>
                                <Binding Path="Initials" />
                                <Binding Path="To" />
                                <Binding Path="MarkBackground" />
                                <Binding Path="MarkGlyph" />
                                <Binding Path="Channel" />
                            </MultiBinding>
                        </ContentPresenter.Content>
                    </ContentPresenter>
                    <controls:SpeechBubble x:Name="Bubble" HorizontalAlignment="Right" MaxWidth="286" Margin="0,26,0,0"
                                           Background="{StaticResource Brush.Action.Bubble}" CornerRadius="{StaticResource Radius.Bubble}"
                                           Padding="14,6,14.5,8">
                        <TextBlock Style="{StaticResource Text.MessageSmall}" Foreground="White" Text="{Binding Message}" TextWrapping="Wrap" />
                    </controls:SpeechBubble>
                    <TextBlock x:Name="Note" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,6,2,-6" Text="{Binding Note}"
                               Visibility="{Binding HasNote, Converter={StaticResource Action.ShowWhenTrue}}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasMessage}" Value="False">
                <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
