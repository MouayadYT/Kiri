<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Assistant.UI.Controls"
                    xmlns:windowing="clr-namespace:Assistant.UI.Windowing">

    <!-- The tokens these styles use. StaticResource cannot see sibling dictionaries in Theme.xaml, so each
         control dictionary merges the token dictionaries it needs. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Surfaces.xaml" />
        <ResourceDictionary Source="../Tokens/Strokes.xaml" />
        <ResourceDictionary Source="../Tokens/Shadows.xaml" />
        <ResourceDictionary Source="../Tokens/Radii.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The Assistant's dark glass with a hairline rim, in whatever form it has: the Search or Ask pill, the floating
         conversation panel, or between them while one grows into the other. The glass is translucent only while the
         window's backdrop blurs what lies behind it (Windowing/BackdropHost), and opaque otherwise
         (PROJECT_SPEC §4.0). -->
    <Style x:Key="GlassSurface" TargetType="controls:SurfaceShape">
        <Setter Property="Fill" Value="{StaticResource Brush.Surface.GlassOpaque}" />
        <Setter Property="Stroke" Value="{StaticResource Brush.Stroke.Rim}" />
        <Setter Property="StrokeThickness" Value="{StaticResource StrokeThickness.Hairline}" />
        <Style.Triggers>
            <Trigger Property="windowing:Backdrop.IsBlurred" Value="True">
                <Setter Property="Fill" Value="{StaticResource Brush.Surface.Glass}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Casts the floating shadow of a glass surface of the same form and size (see Shadows.xaml). -->
    <Style x:Key="SurfaceShadowCaster" TargetType="controls:SurfaceShape">
        <Setter Property="Fill" Value="{StaticResource Brush.Shadow.Caster}" />
        <Setter Property="Margin" Value="{StaticResource Shadow.CasterInset}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Floating}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- The launcher's category panel under the bar: a panel of glass of its own, lighter than the bar's, with the same
         translucency rule. -->
    <Style x:Key="GlassLauncher" TargetType="controls:PanelShape">
        <Setter Property="CornerSize" Value="{StaticResource Radius.Launcher}" />
        <Setter Property="Fill" Value="{StaticResource Brush.Surface.LauncherOpaque}" />
        <Setter Property="Stroke" Value="{StaticResource Brush.Stroke.LauncherRim}" />
        <Setter Property="StrokeThickness" Value="{StaticResource StrokeThickness.Hairline}" />
        <Style.Triggers>
            <Trigger Property="windowing:Backdrop.IsBlurred" Value="True">
                <Setter Property="Fill" Value="{StaticResource Brush.Surface.Launcher}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Casts the launcher panel's shadow. -->
    <Style x:Key="LauncherShadowCaster" TargetType="controls:PanelShape">
        <Setter Property="CornerSize" Value="{StaticResource Radius.Launcher}" />
        <Setter Property="Fill" Value="{StaticResource Brush.Shadow.Caster}" />
        <Setter Property="Margin" Value="{StaticResource Shadow.CasterInset}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Floating}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

</ResourceDictionary>
