<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Assistant.UI.Controls"
                    xmlns:messages="clr-namespace:Assistant.UI.Messages"
                    mc:Ignorable="po">

    <!-- The approval panel of an integration the Assistant found (PROJECT_SPEC section 4.8, step 108): a dark gray panel in the conversation, as wide as a
         card but not one (it is a question, not a result), that says what was found, who made it, what it does, where it comes from, what it may
         need and what is downloaded, and asks Install or Cancel. Its buttons are the pills of the image search question. Provisional until a
         reference shows one. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Tokens/Surfaces.xaml" />
        <ResourceDictionary Source="../Tokens/Strokes.xaml" />
        <ResourceDictionary Source="../Tokens/States.xaml" />
        <ResourceDictionary Source="../Tokens/Radii.xaml" />
        <ResourceDictionary Source="../Icons.xaml" />
        <ResourceDictionary Source="IconButton.xaml" />
        <ResourceDictionary Source="ImageSearch.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="Offer.Padding">16,14,16,16</Thickness>
    <Thickness x:Key="Offer.SectionMargin">0,12,0,0</Thickness>
    <Thickness x:Key="Offer.LineMargin">0,3,0,0</Thickness>
    <sys:Double x:Key="Offer.ProgressHeight">6</sys:Double>
    <SolidColorBrush x:Key="Brush.Offer.Official" Color="#5FD07A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Offer.Track" Color="#33FFFFFF" po:Freeze="True" />

    <!-- What each footer shows, by where the offer stands. -->
    <Style x:Key="Offer.WhenWaiting" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Offer.WhenInstalling" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Offer.WhenFinished" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Offer.WhenNotes" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasNotes}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A heading of a section: small, dim, set apart from what is under it. -->
    <Style x:Key="Offer.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Offer.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.BodySmall}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{StaticResource Offer.LineMargin}" />
    </Style>

    <!-- A line of a list: a small dot in the text column, then the words. -->
    <DataTemplate x:Key="Offer.Bullet">
        <Grid Margin="{StaticResource Offer.LineMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.BodySmall}" Text="&#8226;" Foreground="{StaticResource Brush.Text.Secondary}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Text.BodySmall}" Text="{Binding}" TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>

    <!-- A thin bar that fills as the installation goes, or slides while it cannot be told how far it is. -->
    <Style x:Key="Offer.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource Offer.ProgressHeight}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" ClipToBounds="True">
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Brush.Offer.Track}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource Brush.Text.LinkBlue}" />
                        <Border x:Name="Slider" CornerRadius="3" HorizontalAlignment="Left" Width="90" Visibility="Collapsed"
                                Background="{StaticResource Brush.Text.LinkBlue}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SliderMove" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Slider" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Sliding">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SliderMove" Storyboard.TargetProperty="X" From="-90" To="420" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Sliding" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type messages:IntegrationOfferContent}">
        <Grid Margin="{DynamicResource Message.CardBleed}" AutomationProperties.Name="{Binding Text}">
            <controls:PanelShape Fill="{StaticResource Brush.Surface.Code}" CornerSize="{StaticResource Radius.ContentBlock}" />
            <StackPanel Margin="{StaticResource Offer.Padding}">

                <!-- The question, and the badge that says whether the maker is the app's own. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Margin="12,0,0,0" Padding="9,2,9,3" CornerRadius="10" Background="{StaticResource Brush.Surface.Bubble}"
                            VerticalAlignment="Center" AutomationProperties.Name="{Binding MakerBadge}">
                        <TextBlock x:Name="Badge" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="{Binding MakerBadge}" />
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource Offer.Value}" Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding Offer.IntegrationName}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Style="{StaticResource Offer.Label}" Text="Made by" Margin="{StaticResource Offer.SectionMargin}" />
                <TextBlock Style="{StaticResource Offer.Value}" Text="{Binding MakerText}" />

                <TextBlock Style="{StaticResource Offer.Label}" Text="What it does" Margin="{StaticResource Offer.SectionMargin}" />
                <TextBlock Style="{StaticResource Offer.Value}" Text="{Binding Provides}" />

                <TextBlock Style="{StaticResource Offer.Label}" Text="Where it comes from" Margin="{StaticResource Offer.SectionMargin}" />
                <TextBlock Style="{StaticResource Offer.Value}" Text="{Binding Source}" />

                <TextBlock Style="{StaticResource Offer.Label}" Text="What it may need" Margin="{StaticResource Offer.SectionMargin}" />
                <ItemsControl ItemsSource="{Binding Needs}" ItemTemplate="{StaticResource Offer.Bullet}" Focusable="False" IsTabStop="False" />

                <TextBlock Style="{StaticResource Offer.Label}" Text="On this PC" Margin="{StaticResource Offer.SectionMargin}" />
                <ItemsControl ItemsSource="{Binding Requirements}" ItemTemplate="{StaticResource Offer.Bullet}" Focusable="False" IsTabStop="False" />

                <StackPanel Style="{StaticResource Offer.WhenNotes}">
                    <TextBlock Style="{StaticResource Offer.Label}" Text="Not checked, or worth knowing" Margin="{StaticResource Offer.SectionMargin}" />
                    <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource Offer.Bullet}" Focusable="False" IsTabStop="False" />
                </StackPanel>

                <!-- Waiting for the user's answer. -->
                <StackPanel Style="{StaticResource Offer.WhenWaiting}" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource ImageSearch.DialogPrimary}" Padding="20,7,20,8" Command="{Binding InstallCommand}" Content="{Binding InstallLabel}"
                            AutomationProperties.Name="{Binding Title}" />
                    <Button Style="{StaticResource ImageSearch.DialogButton}" Padding="20,7,20,8" Margin="9,0,0,0" Command="{Binding CancelCommand}" Content="Cancel"
                            AutomationProperties.Name="Cancel, and install nothing" />
                </StackPanel>

                <!-- Installing: what is happening, how far, and a way to stop. -->
                <StackPanel Style="{StaticResource Offer.WhenInstalling}" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Text.BodySmall}" Text="{Binding ProgressText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Style="{StaticResource Offer.ProgressBar}" Margin="0,8,0,0" Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" AutomationProperties.Name="Installation progress" />
                    <Button Style="{StaticResource ImageSearch.DialogButton}" Padding="20,7,20,8" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Command="{Binding CancelCommand}" Content="Cancel" AutomationProperties.Name="Cancel the installation" />
                </StackPanel>

                <!-- Ended: what happened, and where to see the integration. -->
                <StackPanel Style="{StaticResource Offer.WhenFinished}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ResultGlyph" Style="{StaticResource IconGlyph}" StrokeThickness="1.4" Data="{StaticResource Icon.Warning}" Stretch="None"
                              Stroke="{StaticResource Brush.Glyph.Warning}" VerticalAlignment="Top" Margin="0,2,9,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.BodySmall}" Text="{Binding ResultText}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <Button x:Name="OpenSettings" Style="{StaticResource ImageSearch.DialogButton}" Padding="20,7,20,8" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Command="{Binding OpenSettingsCommand}" Content="Open Settings" Visibility="Collapsed"
                            AutomationProperties.Name="Open Settings to see the installed integrations" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOfficial}" Value="True">
                <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.Offer.Official}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                <Setter TargetName="ResultGlyph" Property="Data" Value="{StaticResource Icon.Check}" />
                <Setter TargetName="ResultGlyph" Property="Stroke" Value="{StaticResource Brush.Offer.Official}" />
                <Setter TargetName="OpenSettings" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsInstalled}" Value="True" />
                    <Condition Binding="{Binding CanOpenSettings}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="OpenSettings" Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
