<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Assistant.UI.Controls"
                    xmlns:messages="clr-namespace:Assistant.UI.Messages"
                    mc:Ignorable="po">

    <!-- The panel for a run of the agent that has several steps, or in which something went wrong (PROJECT_SPEC section 4.8, step 117): a dark gray panel in the conversation, as
         wide as a card, with the run's steps as lines (what each is, how it stands, what the user answered when asked, how long it took), a Cancel button while it goes on and,
         when it could not go on, the line that says where. It is made of the same parts as the question the Assistant asks before it changes anything (ToolConfirmation.xaml),
         whose buttons it shares. Provisional until a reference shows one. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Tokens/Surfaces.xaml" />
        <ResourceDictionary Source="../Tokens/Strokes.xaml" />
        <ResourceDictionary Source="../Tokens/States.xaml" />
        <ResourceDictionary Source="../Tokens/Radii.xaml" />
        <ResourceDictionary Source="../Icons.xaml" />
        <ResourceDictionary Source="IconButton.xaml" />
        <ResourceDictionary Source="ImageSearch.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="Task.Padding">16,14,16,16</Thickness>
    <sys:Double x:Key="Task.StepsMaxHeight">280</sys:Double>
    <SolidColorBrush x:Key="Brush.Task.Done" Color="#5FD07A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Task.Dim" Color="#8CFFFFFF" po:Freeze="True" />

    <BooleanToVisibilityConverter x:Key="Task.ShowWhenTrue" />

    <!-- One step of a run, or one action: a mark for how it stands, what it was, how it stands in words, what the user answered, and how long it took. The same line is used
         by the panel in the conversation and by the activity page. -->
    <DataTemplate DataType="{x:Type messages:ActivityStepItem}">
        <Grid Margin="0,10,0,0" AutomationProperties.Name="{Binding Text}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,3,10,0">
                <Ellipse x:Name="Working" Stroke="{StaticResource Brush.Task.Dim}" StrokeThickness="1.6" StrokeDashArray="2 1.6" Visibility="Collapsed" />
                <Ellipse x:Name="Waiting" Fill="{StaticResource Brush.Glyph.Warning}" Width="7" Height="7" Visibility="Collapsed" />
                <Path x:Name="Done" Style="{StaticResource IconGlyph}" StrokeThickness="1.6" Data="{StaticResource Icon.Check}" Stretch="None" Stroke="{StaticResource Brush.Task.Done}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <Path x:Name="Problem" Style="{StaticResource IconGlyph}" StrokeThickness="1.6" Data="{StaticResource Icon.Close}" Stretch="None" Stroke="{StaticResource Brush.Glyph.Warning}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <Ellipse x:Name="NotDone" Fill="{StaticResource Brush.Task.Dim}" Width="5" Height="5" Visibility="Collapsed" />
            </Grid>
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.BodySmall}" Margin="0,2,0,0" Text="{Binding StatusText}" TextWrapping="Wrap" />
                <TextBlock x:Name="Answer" Style="{StaticResource Text.BodySmall}" Margin="0,2,0,0" Text="{Binding ConfirmationText}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Margin="12,3,0,0" VerticalAlignment="Top" Text="{Binding DurationText}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                <Setter TargetName="Working" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                <Setter TargetName="Waiting" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter TargetName="Done" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                <Setter TargetName="Problem" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsNotDone}" Value="True">
                <Setter TargetName="NotDone" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasConfirmation}" Value="True">
                <Setter TargetName="Answer" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Task.WhenFailure" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasFailure}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type messages:AgentTaskContent}">
        <Grid Margin="{DynamicResource Message.CardBleed}" AutomationProperties.Name="{Binding Text}">
            <controls:PanelShape Fill="{StaticResource Brush.Surface.Code}" CornerSize="{StaticResource Radius.ContentBlock}" />
            <StackPanel Margin="{StaticResource Task.Padding}">

                <!-- How the run stands, how many steps it has had and how long it took, and the button that stops it while it goes on. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Style="{StaticResource Text.BodySmall}" Margin="0,2,0,0" Text="{Binding Summary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ImageSearch.DialogButton}" Padding="16,6,16,7" Margin="12,0,0,0" VerticalAlignment="Top"
                            Command="{Binding CancelCommand}" Content="{Binding CancelLabel}" AutomationProperties.Name="Cancel this task"
                            Visibility="{Binding IsRunning, Converter={StaticResource Task.ShowWhenTrue}}" />
                </Grid>

                <!-- The steps. A long run scrolls here, so the line under it stays in view. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{StaticResource Task.StepsMaxHeight}"
                              Focusable="False" IsTabStop="False">
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" IsTabStop="False" AutomationProperties.Name="Steps" />
                </ScrollViewer>

                <!-- Where the run could not go on. -->
                <Grid Style="{StaticResource Task.WhenFailure}" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource IconGlyph}" StrokeThickness="1.4" Data="{StaticResource Icon.Warning}" Stretch="None"
                          Stroke="{StaticResource Brush.Glyph.Warning}" VerticalAlignment="Top" Margin="0,2,9,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodySmall}" Text="{Binding FailurePoint}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>

                <Button Style="{StaticResource ImageSearch.DialogButton}" Padding="16,6,16,7" Margin="0,14,0,0" HorizontalAlignment="Left"
                        Command="{Binding OpenActivityCommand}" Content="See all activity" AutomationProperties.Name="See all activity in Settings"
                        Visibility="{Binding HasOpenActivity, Converter={StaticResource Task.ShowWhenTrue}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
