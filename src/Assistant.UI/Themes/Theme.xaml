        <ResourceDictionary Source="Tokens/States.xaml" />
        <ResourceDictionary Source="Tokens/Shadows.xaml" />
        <ResourceDictionary Source="Tokens/Motion.xaml" />
        <ResourceDictionary Source="Tokens/Voice.xaml" />
        <ResourceDictionary Source="Tokens/Orb.xaml" />
        <ResourceDictionary Source="Tokens/Caret.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Controls/IconButton.xaml" />
        <ResourceDictionary Source="Controls/Menu.xaml" />
        <ResourceDictionary Source="Controls/Surface.xaml" />
        <ResourceDictionary Source="Controls/PromptInput.xaml" />
        <ResourceDictionary Source="Controls/Messages.xaml" />
        <ResourceDictionary Source="Controls/ResultContent.xaml" />
        <ResourceDictionary Source="Controls/Conversation.xaml" />
