<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Dark glass: black whose opacity falls from top to bottom, over the blurred backdrop, so the lower part takes its
         color from whatever is behind: gray over white, dark over dark, never milky. Calibrated over white to the
         Search or Ask reference: about 91 % black at the top, 73 % in the middle and 49 % at the bottom (23, 69 and
         129 over white). The floating conversation panel is a larger piece of the same glass, stretched to its height. -->
    <LinearGradientBrush x:Key="Brush.Surface.Glass" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#E8000000" />
        <GradientStop Offset="0.5" Color="#BA000000" />
        <GradientStop Offset="1" Color="#7E000000" />
    </LinearGradientBrush>

    <!-- The same glass made opaque, for when there is no blurred backdrop (PROJECT_SPEC §4.0): each stop is the glass
         over the reference's white background, so it matches the reference exactly. -->
    <LinearGradientBrush x:Key="Brush.Surface.GlassOpaque" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#171717" />
        <GradientStop Offset="0.5" Color="#454545" />
        <GradientStop Offset="1" Color="#818181" />
    </LinearGradientBrush>

    <!-- The launcher's category panel under the Search or Ask bar: a lighter layer of the same kind of glass, measured
         from its reference, which was captured over white: about 52 % black at the top, falling in a straight line to
         18 % at the bottom. Opaque, each stop is that glass over the reference's white (PROJECT_SPEC §4.0). -->
    <LinearGradientBrush x:Key="Brush.Surface.Launcher" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#85000000" />
        <GradientStop Offset="1" Color="#2E000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Surface.LauncherOpaque" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#7A7A7A" />
        <GradientStop Offset="1" Color="#D0D0D0" />
    </LinearGradientBrush>

    <!-- A command's row in a list on glass, such as the launcher's: the highlighted one is a white layer, measured from
         the launcher reference's results list; the one under the pointer is a fainter one, provisional. -->
    <SolidColorBrush x:Key="Brush.Surface.CommandItemSelected" Color="#1CFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.CommandItemHover" Color="#0DFFFFFF" po:Freeze="True" />

    <!-- The key that does the action a highlighted search result offers: a small cap, a light layer over the glass,
         measured from the Search reference (about a third white). -->
    <SolidColorBrush x:Key="Brush.Surface.ResultKey" Color="#5AFFFFFF" po:Freeze="True" />

    <!-- The chips over the search results that narrow them to one kind (measured from the Search reference: a chip is the panel's glass
         10 % lighter, and the chosen one lighter still), and the plate behind the rest of the top hit's name that the field shows after what
         was typed (the pill's glass 18 % lighter). -->
    <SolidColorBrush x:Key="Brush.Surface.ScopeChip" Color="#1AFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.ScopeChipHover" Color="#26FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.ScopeChipActive" Color="#47FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Completion" Color="#2EFFFFFF" po:Freeze="True" />

    <!-- A conversation's avatar, measured from the Messages reference: a group's people sit on a disc that is a little
         over a third white, and a person without a photo is a periwinkle disc, lighter at its top. -->
    <SolidColorBrush x:Key="Brush.Surface.AvatarCluster" Color="#61FFFFFF" po:Freeze="True" />
    <LinearGradientBrush x:Key="Brush.Surface.AvatarInitials" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#C2CBEE" />
        <GradientStop Offset="1" Color="#94A1D8" />
    </LinearGradientBrush>

    <!-- Measured from the floating conversation reference. A glass button is a translucent gray disc: it lifts dark
         glass and dims bright glass, such as the voice glow. A message bubble is a faint white layer over the glass. -->
    <SolidColorBrush x:Key="Brush.Control.Glass" Color="#616C6C6C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Bubble" Color="#16FFFFFF" po:Freeze="True" />

    <!-- A rich card in an answer is opaque black over the glass, in the floating conversation reference. -->
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="#000000" po:Freeze="True" />

    <!-- Behind a gallery's images, showing in its gaps and empty tiles: opaque dark gray, in the photo reference. A code
         block uses the same dark gray, so neither reads as a black card. -->
    <SolidColorBrush x:Key="Brush.Surface.Gallery" Color="#1E1E1E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Code" Color="#1E1E1E" po:Freeze="True" />

    <!-- Behind a few words of inline code in a line of prose: a faint white layer over the glass. -->
    <SolidColorBrush x:Key="Brush.Surface.InlineCode" Color="#33FFFFFF" po:Freeze="True" />

    <!-- A list of files is a faint white layer over the glass, and each file's icon a slightly brighter tile.
         Provisional until a reference shows them. -->
    <SolidColorBrush x:Key="Brush.Surface.FileList" Color="#12FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.FileIcon" Color="#1FFFFFFF" po:Freeze="True" />

    <!-- The History window's glass. Windows draws a dark system backdrop behind the whole window
         (Windowing/WindowFrameHost): Mica, near-black gray tinted by the desktop wallpaper while the window is active.
         Its surfaces are neutral layers over it, black or white and never tinted, so whatever hue the glass has comes
         from the wallpaper: warm over the reference's green and yellow one, purple over a purple one. The workspace is
         the darkest layer, the sidebar a little lighter and clearer, and the cards and glass buttons lighter again.
         Without a backdrop each is opaque, in its color over Mica's plain dark gray. -->
    <SolidColorBrush x:Key="Brush.Surface.Sidebar" Color="#0DFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.SidebarOpaque" Color="#2B2B2B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Workspace" Color="#1F000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.WorkspaceOpaque" Color="#1C1C1C" po:Freeze="True" />

    <!-- A conversation's card in the History window's sidebar: a lighter layer of frosted glass with one faint rim, a
         little brighter along its top. Hovered and selected cards are lighter. -->
    <SolidColorBrush x:Key="Brush.Surface.HistoryCard" Color="#1CFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.HistoryCardHover" Color="#08FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.HistoryCardSelected" Color="#12FFFFFF" po:Freeze="True" />
    <LinearGradientBrush x:Key="Brush.Stroke.HistoryCardRim" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#33FFFFFF" />
        <GradientStop Offset="0.1" Color="#0DFFFFFF" />
        <GradientStop Offset="0.9" Color="#08FFFFFF" />
        <GradientStop Offset="1" Color="#1AFFFFFF" />
    </LinearGradientBrush>

    <!-- The open conversation's card is ringed in blue around its outline, measured from the reference. -->
    <SolidColorBrush x:Key="Brush.Stroke.HistoryCardSelected" Color="#2F6BD5" po:Freeze="True" />

    <!-- A row of the History window's list lies on the sidebar with no surface of its own. The open conversation's row
         is a lighter layer, measured from the list reference; a hovered one is lightened a little. -->
    <SolidColorBrush x:Key="Brush.Surface.HistoryRowHover" Color="#08FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.HistoryRowSelected" Color="#22FFFFFF" po:Freeze="True" />

    <!-- A glass button is lighter while its menu is open, as the History window's view button is in the menu
         reference. -->
    <SolidColorBrush x:Key="Brush.Control.GlassOpen" Color="#718D8D8D" po:Freeze="True" />

    <!-- A menu, such as the History window's view menu: gray glass, a light layer over the blurred backdrop that is a
         little brighter just inside its top and bottom edges, measured from the menu reference. Without a backdrop it
         is opaque, in the color it has over the History window's sidebar with no wallpaper showing through. -->
    <LinearGradientBrush x:Key="Brush.Surface.Menu" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#2AFFFFFF" />
        <GradientStop Offset="0.06" Color="#22FFFFFF" />
        <GradientStop Offset="0.94" Color="#22FFFFFF" />
        <GradientStop Offset="1" Color="#2AFFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Surface.MenuOpaque" Color="#464646" po:Freeze="True" />

    <!-- The History window's own buttons for closing, minimizing and maximizing it, in the reference's red, yellow and
         green, gray while the window is inactive, with a dark glyph shown on hover. -->
    <SolidColorBrush x:Key="Brush.WindowButton.Close" Color="#F45B51" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.WindowButton.Minimize" Color="#FCBB00" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.WindowButton.Maximize" Color="#14BE00" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.WindowButton.Inactive" Color="#33FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.WindowButton.Glyph" Color="#A6000000" po:Freeze="True" />

    <!-- The round copy button in a rich card, measured from the result card reference: a dark gray disc with a light
         glyph. On a code block's dark gray, the disc is lighter so it still shows. -->
    <SolidColorBrush x:Key="Brush.Control.CardButton" Color="#232323" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Control.CodeButton" Color="#333333" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Glyph.CardButton" Color="#E9E9E9" po:Freeze="True" />

</ResourceDictionary>
