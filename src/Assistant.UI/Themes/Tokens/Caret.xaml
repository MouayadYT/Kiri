<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">

    <!-- The glowing text caret (Controls/GlowCaret), measured from the Search or Ask reference: a white core 2 DIPs
         wide and a line tall, in a glow reaching about 12 DIPs either side, nearly white at the core and cyan-blue
         above, warm yellow below, further out. -->
    <sys:Double x:Key="Size.CaretWidth">2</sys:Double>
    <sys:Double x:Key="Size.CaretGlow">12</sys:Double>
    <SolidColorBrush x:Key="Brush.Caret.Core" Color="#FFFFFF" po:Freeze="True" />
    <Color x:Key="Color.Caret.GlowUpper">#B0E2FF</Color>
    <Color x:Key="Color.Caret.GlowLower">#FFE196</Color>

</ResourceDictionary>
