<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">

    <!-- Interaction states on dark glass. Hover and pressed are white layers drawn over a control's own fill. -->
    <SolidColorBrush x:Key="Brush.State.Hover" Color="#1AFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.State.Pressed" Color="#2EFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.State.FocusRing" Color="#B3FFFFFF" po:Freeze="True" />
    <sys:Double x:Key="Opacity.State.Disabled">0.4</sys:Double>

</ResourceDictionary>
