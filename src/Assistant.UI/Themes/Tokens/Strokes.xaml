<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">

    <!-- Thicknesses, in DIPs. -->
    <sys:Double x:Key="StrokeThickness.Hairline">1</sys:Double>
    <sys:Double x:Key="StrokeThickness.Glyph">1.5</sys:Double>
    <sys:Double x:Key="StrokeThickness.FocusRing">2</sys:Double>
    <sys:Double x:Key="StrokeThickness.HistoryCardSelected">2.5</sys:Double>

    <!-- Hairline rim around glass: a faint highlight along the top, a brighter one along the bottom. -->
    <LinearGradientBrush x:Key="Brush.Stroke.Rim" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#26FFFFFF" />
        <GradientStop Offset="0.08" Color="#0AFFFFFF" />
        <GradientStop Offset="0.92" Color="#0AFFFFFF" />
        <GradientStop Offset="1" Color="#4DFFFFFF" />
    </LinearGradientBrush>


    <!-- Hairline rim around the launcher's panel: as the bar's, but a bright line along its bottom edge, where the
         reference shows the glass over white. -->
    <LinearGradientBrush x:Key="Brush.Stroke.LauncherRim" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#26FFFFFF" />
        <GradientStop Offset="0.08" Color="#0AFFFFFF" />
        <GradientStop Offset="0.92" Color="#0AFFFFFF" />
        <GradientStop Offset="1" Color="#CCFFFFFF" />
    </LinearGradientBrush>

    <!-- A menu's edge, measured from the view menu reference: a light rim just inside it, brightest along the top and
         bottom, within a near-black hairline half as thick. -->
    <LinearGradientBrush x:Key="Brush.Stroke.MenuRim" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#4FFFFFFF" />
        <GradientStop Offset="0.15" Color="#1AFFFFFF" />
        <GradientStop Offset="0.85" Color="#1AFFFFFF" />
        <GradientStop Offset="1" Color="#4FFFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Stroke.MenuOutline" Color="#E0000000" po:Freeze="True" />
    <sys:Double x:Key="StrokeThickness.MenuOutline">0.5</sys:Double>

    <!-- A hairline between the rows of a list, such as a list of files. -->
    <SolidColorBrush x:Key="Brush.Stroke.Separator" Color="#1FFFFFFF" po:Freeze="True" />

    <!-- Hairline rim around a glass button: light along the top and bottom, dark at the sides. -->
    <LinearGradientBrush x:Key="Brush.Stroke.ControlRim" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#40FFFFFF" />
        <GradientStop Offset="0.3" Color="#00FFFFFF" />
        <GradientStop Offset="0.5" Color="#26000000" />
        <GradientStop Offset="0.7" Color="#00FFFFFF" />
        <GradientStop Offset="1" Color="#40FFFFFF" />
    </LinearGradientBrush>

</ResourceDictionary>
