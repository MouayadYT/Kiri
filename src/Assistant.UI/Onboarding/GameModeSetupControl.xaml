<UserControl x:Class="Assistant.UI.Onboarding.GameModeSetupControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SetupStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource SetupCard}" Margin="0,0,0,12"><StackPanel>
            <CheckBox x:Name="GamesQuestion" Content="Pause AI when a game is running" IsChecked="{Binding EnableGameMode}" Style="{StaticResource SetupCheck}" FontSize="15" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Pause AI when a game is running"/>
            <CheckBox x:Name="CreativeAppsQuestion" Content="Pause AI when a creative app is running" IsChecked="{Binding EnableCreativeApps}" Style="{StaticResource SetupCheck}" FontSize="15" Margin="0,18,0,0" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Pause AI when a creative app is running"/>
        </StackPanel></Border>
        <TextBlock Text="You can change either anytime in Settings → General." Style="{StaticResource SetupMuted}" Margin="4,0,0,16"/>
        <Border Style="{StaticResource SetupCard}">
            <CheckBox x:Name="StartOnBootQuestion" Content="Start Assistant on boot" IsChecked="{Binding StartOnBoot}" Style="{StaticResource SetupCheck}" FontSize="15" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Start Assistant on boot"/>
        </Border>
    </StackPanel>
</UserControl>