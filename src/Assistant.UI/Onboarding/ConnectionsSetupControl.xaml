<UserControl x:Class="Assistant.UI.Onboarding.ConnectionsSetupControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SetupStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <DrawingImage x:Key="McpIcon"><DrawingImage.Drawing><GeometryDrawing Brush="#F5F5F5" Geometry="M 6,2 L 13,9 6,16 3,13 7,9 3,5 Z M 14,2 L 21,9 14,16 11,13 15,9 11,5 Z"/></DrawingImage.Drawing></DrawingImage>
            <DrawingImage x:Key="HomeAssistantIcon"><DrawingImage.Drawing><GeometryDrawing Brush="#18BCF2" Geometry="M 12,2 L 22,12 19,12 19,21 14,21 14,15 10,15 10,21 5,21 5,12 2,12 Z"/></DrawingImage.Drawing></DrawingImage>
            <!-- Discord's mark, in its own colour. -->
            <DrawingImage x:Key="DiscordIcon"><DrawingImage.Drawing><GeometryDrawing Brush="#5865F2" Geometry="F0 M20.317,4.3698 A19.7913,19.7913 0 0 0 15.4319,2.8546 A0.0741,0.0741 0 0 0 15.3534,2.8917 C15.1424,3.267 14.9087,3.7565 14.7451,4.1412 C12.9004,3.865 11.0651,3.865 9.2583,4.1412 C9.0947,3.7479 8.8525,3.267 8.6406,2.8917 A0.077,0.077 0 0 0 8.5621,2.8547 A19.7363,19.7363 0 0 0 3.6769,4.3697 A0.0699,0.0699 0 0 0 3.6448,4.3974 C0.5334,9.0458 -0.319,13.5799 0.0992,18.0578 A0.0824,0.0824 0 0 0 0.1304,18.1139 C2.1832,19.6215 4.1717,20.5367 6.1233,21.1433 A0.0777,0.0777 0 0 0 6.2075,21.1157 C6.6691,20.4853 7.0806,19.8205 7.4335,19.1215 A0.076,0.076 0 0 0 7.3919,19.0158 C6.7391,18.7682 6.1176,18.4663 5.5197,18.1235 A0.077,0.077 0 0 1 5.5121,17.9958 C5.6379,17.9015 5.7638,17.8035 5.8839,17.7044 A0.0743,0.0743 0 0 1 5.9615,17.6939 C9.8893,19.4872 14.1415,19.4872 18.0229,17.6939 A0.0739,0.0739 0 0 1 18.1014,17.7034 C18.2216,17.8024 18.3474,17.9015 18.4742,17.9958 A0.077,0.077 0 0 1 18.4676,18.1234 A12.2986,12.2986 0 0 1 16.5946,19.0148 A0.0766,0.0766 0 0 0 16.5539,19.1215 C16.9143,19.8195 17.3258,20.4843 17.7789,21.1147 A0.076,0.076 0 0 0 17.8631,21.1433 C19.8241,20.5366 21.8126,19.6214 23.8654,18.1139 A0.077,0.077 0 0 0 23.8967,18.0587 C24.3971,12.8817 23.0585,8.3848 20.3482,4.3983 A0.061,0.061 0 0 0 20.317,4.3698 Z M8.02,15.3312 C6.8375,15.3312 5.8631,14.2455 5.8631,12.9122 C5.8631,11.579 6.8186,10.4933 8.0201,10.4933 C9.2309,10.4933 10.1958,11.5885 10.1769,12.9123 C10.1769,14.2455 9.2214,15.3312 8.02,15.3312 Z M15.9948,15.3312 C14.8123,15.3312 13.8379,14.2455 13.8379,12.9122 C13.8379,11.579 14.7933,10.4933 15.9948,10.4933 C17.2056,10.4933 18.1705,11.5885 18.1516,12.9123 C18.1516,14.2455 17.2056,15.3312 15.9948,15.3312 Z"/></DrawingImage.Drawing></DrawingImage>
            <Style x:Key="AppIcon" TargetType="Image">
                <Setter Property="Source" Value="{StaticResource McpIcon}"/><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Icon}" Value="todo"><Setter Property="Source" Value="/Assistant.UI;component/Onboarding/Icons/microsoft-todo.png"/><Setter Property="Width" Value="100"/><Setter Property="Height" Value="100"/></DataTrigger>
                    <DataTrigger Binding="{Binding Icon}" Value="discord"><Setter Property="Source" Value="{StaticResource DiscordIcon}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Icon}" Value="beeper"><Setter Property="Source" Value="/Assistant.UI;component/Onboarding/Icons/beeper.png"/></DataTrigger>
                    <DataTrigger Binding="{Binding Icon}" Value="homeassistant"><Setter Property="Source" Value="{StaticResource HomeAssistantIcon}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ConnectionField" TargetType="TextBox">
                <Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="Background" Value="#18FFFFFF"/>
                <Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="White"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Apps}" Visibility="{Binding ShowsApps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Show}}">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource SetupCard}" Margin="0,0,0,12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Image Style="{StaticResource AppIcon}" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="6,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SetupText}" FontWeight="SemiBold" FontSize="17"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SetupMuted}" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding State}" Style="{StaticResource SetupMuted}" Foreground="#F5F5F5" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="{Binding Label}" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SetupButton}" VerticalAlignment="Center" MinWidth="105" AutomationProperties.Name="{Binding Name, StringFormat=Connect {0}}"/>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{Binding AddLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding AddCommand}" Style="{StaticResource SetupButton}" HorizontalAlignment="Left" Margin="0,4,0,20"/>
        <Border Style="{StaticResource SetupCard}" Visibility="{Binding ShowAddEditor, Converter={StaticResource Show}}" Margin="0,0,0,18">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SetupText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <TextBlock Text="{Binding EditorHelp}" Style="{StaticResource SetupMuted}" TextWrapping="Wrap" Margin="0,-8,0,16" Visibility="{Binding HasEditorHelp, Converter={StaticResource Show}}"/>
                <!-- A server of the user's own has a name and a way of signing in to choose; Home Assistant's form is its address and a token. -->
                <StackPanel Visibility="{Binding IsServerEditor, Converter={StaticResource Show}}" Margin="0,0,0,14">
                    <TextBlock Text="Name" Style="{StaticResource SetupMuted}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConnectionField}" MaxLength="80" AutomationProperties.Name="MCP server name"/>
                </StackPanel>
                <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource SetupMuted}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConnectionField}" MaxLength="2048" AutomationProperties.Name="{Binding AddressLabel}"/>
                <TextBlock Text="{Binding AddressHint}" Style="{StaticResource SetupMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Visibility="{Binding IsServerEditor, Converter={StaticResource Show}}">
                    <TextBlock Text="Authentication" Style="{StaticResource SetupMuted}" Margin="0,14,0,6"/>
                    <ComboBox ItemsSource="{Binding AuthenticationOptions}" SelectedItem="{Binding Authentication}" Style="{StaticResource SettingsComboBox}" Height="38" AutomationProperties.Name="MCP authentication"/>
                </StackPanel>
                <StackPanel Visibility="{Binding UsesToken, Converter={StaticResource Show}}" Margin="0,14,0,0">
                    <TextBlock Text="Access token" Style="{StaticResource SetupMuted}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TokenBox" PasswordChanged="OnTokenChanged" Background="#1FFFFFFF" Foreground="White" BorderBrush="#40FFFFFF" Padding="10" FontSize="14" AutomationProperties.Name="Access token"/>
                    <TextBlock Text="Saved securely in Windows Credential Manager." Style="{StaticResource SetupMuted}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Command="{Binding CancelEditorCommand}" Style="{StaticResource SetupButton}" Margin="0,0,8,0"/>
                    <Button Content="Connect" Command="{Binding SaveServerCommand}" Style="{StaticResource SetupPrimary}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- What the last connection came to; it takes no room while there is nothing to say. -->
        <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SetupMuted}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource Show}}">
            <Button Content="Copy sign-in link" Command="{Binding CopySignInLinkCommand}" Visibility="{Binding HasSignInLink, Converter={StaticResource Show}}" Style="{StaticResource SetupButton}" Margin="0,0,8,0"/>
            <Button Content="Cancel connection" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Show}}" Style="{StaticResource SetupButton}"/>
        </StackPanel>
        <TextBlock Text="Manage or remove them anytime in Settings → Integrations." Style="{StaticResource SetupMuted}" Visibility="{Binding ShowsApps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Show}}"/>
    </StackPanel>
</UserControl>
