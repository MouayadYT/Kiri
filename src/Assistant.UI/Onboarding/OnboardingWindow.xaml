<Window x:Class="Assistant.UI.Onboarding.OnboardingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:setup="clr-namespace:Assistant.UI.Onboarding"
    Title="Welcome to Kiri" Width="790" Height="790" MinWidth="660" MinHeight="600" Background="Transparent" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SetupStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="48" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <!-- The same backdrop and layer as the Settings window: Windows' own Mica, which takes its colour from what is behind the window, under the workspace's layer. -->
    <Grid x:Name="Root" Style="{StaticResource HistoryWorkspace}">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="kiri" Style="{StaticResource SetupText}" FontWeight="SemiBold" Margin="30,0,0,0" VerticalAlignment="Center"/>
        <Button Content="✕" Style="{StaticResource SetupButton}" BorderThickness="0" Background="Transparent" Padding="14,8" HorizontalAlignment="Right" Margin="0,0,12,0" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close setup"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="38,12,38,20">
                <WrapPanel x:Name="Steps" Margin="0,0,0,22">
                    <TextBlock x:Name="AiStep" Text="01  YOUR AI" Foreground="#F5F5F5" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="   /   " Foreground="#4DFFFFFF" FontSize="11"/>
                    <TextBlock x:Name="VoiceStep" Text="02  YOUR VOICE" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="   /   " Foreground="#4DFFFFFF" FontSize="11"/>
                    <TextBlock x:Name="ControlStep" Text="03  RECOGNITION" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="   /   " Foreground="#4DFFFFFF" FontSize="11"/>
                    <TextBlock x:Name="GamingStep" Text="04  GAMING" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="   /   " Foreground="#4DFFFFFF" FontSize="11"/>
                    <TextBlock x:Name="CleanupStep" Text="05  CLEANUP" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="   /   " Foreground="#4DFFFFFF" FontSize="11"/>
                    <TextBlock x:Name="ConnectionsStep" Text="06  CONNECT" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="   /   " Foreground="#4DFFFFFF" FontSize="11"/>
                    <TextBlock x:Name="SearchStep" Text="07  SEARCH" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                </WrapPanel>
                <TextBlock x:Name="Heading" Text="Choose an AI model" Style="{StaticResource SetupText}" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,24" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="Subtitle" Text="" Visibility="Collapsed" Style="{StaticResource SetupMuted}" FontSize="14"/>
                <setup:AiSetupControl x:Name="AiPage"/>
                <setup:VoiceSetupControl x:Name="VoicePage" Visibility="Collapsed"/>
                <setup:VoiceControlSetupControl x:Name="ControlPage" Visibility="Collapsed" ShowApplyButton="False"/>
                <setup:GameModeSetupControl x:Name="GamingPage" Visibility="Collapsed"/>
                <setup:CleanupSetupControl x:Name="CleanupPage" Visibility="Collapsed"/>
                <setup:ConnectionsSetupControl x:Name="ConnectionsPage" Visibility="Collapsed" DataContext="{Binding Connections}"/>
                <setup:SearchSetupControl x:Name="SearchPage" Visibility="Collapsed" DataContext="{Binding Search}" ShowApplyButton="False"/>
                <StackPanel x:Name="DonePage" Visibility="Collapsed" Margin="0,35,0,30" HorizontalAlignment="Center">
                    <Border Width="90" Height="90" CornerRadius="45" Background="#332F6BD5" BorderBrush="#802F6BD5" BorderThickness="1"><TextBlock Text="✓" FontSize="40" Foreground="#F5F5F5" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#16FFFFFF" BorderThickness="0,1,0,0" Padding="38,16,38,24">
            <StackPanel>
                <StackPanel Visibility="{Binding IsModelBusy, Converter={StaticResource Show}}"><ProgressBar Height="4" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SetupButton}" HorizontalAlignment="Right" Margin="0,8,0,0"/></StackPanel>
                <TextBlock x:Name="StatusFooter" Text="{Binding FooterStatus}" Style="{StaticResource SetupMuted}" MaxHeight="54" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
                <Grid><Button x:Name="BackButton" Content="Back" Style="{StaticResource SetupButton}" HorizontalAlignment="Left" Visibility="Collapsed" Click="OnBack" IsEnabled="{Binding IsIdle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SkipButton" Content="Skip" Style="{StaticResource SetupButton}" Visibility="Collapsed" Click="OnSkip" IsEnabled="{Binding IsIdle}" Margin="0,0,10,0" AutomationProperties.Name="Skip the voice"/>
                        <Button x:Name="NextButton" Content="Next →" Style="{StaticResource SetupPrimary}" Click="OnNext" IsEnabled="{Binding CanContinueAi}" MinWidth="118"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
