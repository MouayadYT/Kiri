<UserControl x:Class="Assistant.UI.Onboarding.LibraryControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SetupStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource SetupText}" Text="Downloaded models" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,10"/>

        <ItemsControl ItemsSource="{Binding Installed}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource SetupCard}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource SetupText}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource SetupMuted}" Margin="0,5,12,0"/></StackPanel>
                <Button Grid.Column="1" Content="Delete" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SetupButton}"/>
            </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource Show}}" Margin="0,12,0,0"><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="4" Maximum="100"/><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SetupButton}" HorizontalAlignment="Right" Margin="0,8,0,0"/></StackPanel>
        <TextBlock Text="{Binding Status}" Style="{StaticResource SetupMuted}" Margin="0,12,0,12" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
