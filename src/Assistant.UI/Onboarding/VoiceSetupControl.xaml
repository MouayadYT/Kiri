<UserControl x:Class="Assistant.UI.Onboarding.VoiceSetupControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SetupStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="ApiField" TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}"><Setter Property="Width" Value="Auto"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    </ResourceDictionary></UserControl.Resources>
    <StackPanel>
        <CheckBox Content="Use a custom speech API" IsChecked="{Binding UseApi}" Foreground="#F5F5F5" FontSize="14" Margin="0,0,0,18" IsEnabled="{Binding IsIdle}"/>
        <StackPanel IsEnabled="{Binding IsIdle}">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding UseApi}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding VoiceModels}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="Name" Style="{StaticResource SettingsComboBox}" Height="38" AutomationProperties.Name="Voice model"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding DownloadVoiceCommand}" Margin="12,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SetupButton}"><Setter Property="Content" Value="Download"/><Style.Triggers><DataTrigger Binding="{Binding SelectedVoice.NeedsUpdate}" Value="True"><Setter Property="Content" Value="Update"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedVoice}" Visibility="{Binding SelectedVoice.CanDelete, Converter={StaticResource Show}}" Style="{StaticResource SetupButton}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource SetupCard}" Margin="0,14,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SetupMuted}"><Run Text="{Binding SelectedVoice.Ram, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedVoice.Size, Mode=OneWay}"/></TextBlock>
                    <TextBlock Style="{StaticResource SetupMuted}" Text="{Binding VoiceInstallState}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Run the voice on" Style="{StaticResource SetupText}" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding VoiceDevices}" SelectedItem="{Binding VoiceDevice}" DisplayMemberPath="Name" Style="{StaticResource SettingsComboBox}" Height="38" AutomationProperties.Name="Voice compute device">
                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource SettingsComboItem}"><Setter Property="IsEnabled" Value="{Binding Available}"/><Setter Property="ToolTip" Value="{Binding Note}"/></Style></ComboBox.ItemContainerStyle>
            </ComboBox>

        </StackPanel>
        <StackPanel Visibility="{Binding UseApi, Converter={StaticResource Show}}" IsEnabled="{Binding IsIdle}">
            <TextBlock Style="{StaticResource SetupMuted}" Text="OpenAI-compatible speech. Your API key is stored in Windows Credential Manager. Spoken text is sent to this endpoint." Margin="0,0,0,14"/>
            <TextBlock Text="Speech endpoint" Style="{StaticResource SetupText}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding ApiEndpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ApiField}" Height="36" AutomationProperties.Name="Speech API endpoint"/>
            <Grid Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Model" Style="{StaticResource SetupText}" Margin="0,0,0,6"/><TextBox Text="{Binding ApiModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ApiField}" Height="36" AutomationProperties.Name="Speech API model"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Voice" Style="{StaticResource SetupText}" Margin="0,0,0,6"/><TextBox Text="{Binding ApiVoice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ApiField}" Height="36" AutomationProperties.Name="Speech API voice"/></StackPanel>
            </Grid>
            <TextBlock Text="API key (leave blank to keep this endpoint's saved key)" Style="{StaticResource SetupText}" Margin="0,0,0,6"/>
            <PasswordBox PasswordChanged="OnPasswordChanged" Background="#1FFFFFFF" Foreground="White" BorderBrush="#40FFFFFF" Padding="10" FontSize="14" AutomationProperties.Name="Speech API key"/>
            <CheckBox Content="Allow remote speech (turn off Local Only)" IsChecked="{Binding AllowRemoteSpeech}" Foreground="#F5F5F5" Margin="0,14,0,0" Visibility="{Binding IsRemoteApi, Converter={StaticResource Show}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <Button Content="Test voice &amp; speed" Command="{Binding TestCommand}" Style="{StaticResource SetupPrimary}"/>
            <Button Content="Use voice" Command="{Binding SaveVoiceCommand}" Style="{StaticResource SetupButton}" Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding Benchmark}" Style="{StaticResource SetupText}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
