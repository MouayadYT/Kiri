<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="Show" />
    <Style x:Key="SetupModelList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="Transparent"><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter>
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SetupText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SetupMuted" TargetType="TextBlock" BasedOn="{StaticResource SetupText}">
        <Setter Property="Foreground" Value="#99FFFFFF"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SetupButton" TargetType="Button">
        <Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="Background" Value="#20FFFFFF"/>
        <Setter Property="BorderBrush" Value="#28FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#99FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SetupPrimary" TargetType="Button" BasedOn="{StaticResource SetupButton}">
        <Setter Property="Background" Value="#2F6BD5"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SetupCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" BorderThickness="1" BorderBrush="#80FFFFFF" Background="#20FFFFFF" VerticalAlignment="Center">
                    <TextBlock x:Name="Tick" Text="✓" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#2F6BD5"/><Setter TargetName="Box" Property="BorderBrush" Value="#2F6BD5"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SetupCard" TargetType="Border"><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/><Setter Property="Background" Value="#12FFFFFF"/><Setter Property="BorderBrush" Value="#20FFFFFF"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="SetupModelItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Style="{StaticResource SetupCard}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#6C9BEA"/><Setter TargetName="Card" Property="Background" Value="#332F6BD5"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
