<UserControl x:Class="Assistant.UI.Onboarding.CleanupSetupControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SetupStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <!-- The number in the sentence: it looks like part of it, and is typed over. -->
            <Style x:Key="SetupNumber" TargetType="TextBox">
                <Setter Property="Width" Value="64"/><Setter Property="Margin" Value="8,0"/><Setter Property="Padding" Value="8,5"/>
                <Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="CaretBrush" Value="#F5F5F5"/><Setter Property="Background" Value="#20FFFFFF"/>
                <Setter Property="BorderBrush" Value="#45FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="IBeam"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#99FFFFFF"/></Trigger>
                        <Trigger Property="Tag" Value="invalid"><Setter TargetName="Surface" Property="BorderBrush" Value="#FF9A9A"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SetupHours" TargetType="TextBox" BasedOn="{StaticResource SetupNumber}">
                <Style.Triggers><DataTrigger Binding="{Binding BarChatHoursInvalid}" Value="True"><Setter Property="Tag" Value="invalid"/></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="SetupDays" TargetType="TextBox" BasedOn="{StaticResource SetupNumber}">
                <Style.Triggers><DataTrigger Binding="{Binding WindowChatDaysInvalid}" Value="True"><Setter Property="Tag" Value="invalid"/></DataTrigger></Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource SetupCard}" Margin="0,0,0,16"><StackPanel>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="BarChatsQuestion" Content="Delete all chats from the search bar after" IsChecked="{Binding DeleteBarChats}" Style="{StaticResource SetupCheck}" FontSize="15" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Delete all chats from the search bar"/>
                <TextBox x:Name="BarChatHoursField" Style="{StaticResource SetupHours}" MaxLength="6" Text="{Binding BarChatHours, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Hours before chats from the search bar are deleted"/>
                <TextBlock Text="hours" Style="{StaticResource SetupText}" FontSize="15" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <CheckBox x:Name="WindowChatsQuestion" Content="Delete all full screen chats after" IsChecked="{Binding DeleteWindowChats}" Style="{StaticResource SetupCheck}" FontSize="15" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Delete all full screen chats"/>
                <TextBox x:Name="WindowChatDaysField" Style="{StaticResource SetupDays}" MaxLength="5" Text="{Binding WindowChatDays, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Days before full screen chats are deleted"/>
                <TextBlock Text="days" Style="{StaticResource SetupText}" FontSize="15" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="CleanupProblemText" Text="{Binding CleanupProblem}" Foreground="#FFB4B4" Style="{StaticResource SetupMuted}" Margin="0,14,0,0" Visibility="{Binding HasCleanupProblem, Converter={StaticResource Show}}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel></Border>
        <TextBlock Text="You can change this anytime in Settings → Privacy." Style="{StaticResource SetupMuted}" Margin="4,0,0,16"/>
    </StackPanel>
</UserControl>