<Window x:Class="Assistant.UI.ImageSearch.ImageSearchResultsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Assistant.UI.Controls"
        Title="Image Search"
        Width="{StaticResource ImageSearch.Width}" Height="{StaticResource ImageSearch.Height}"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize" ShowInTaskbar="True"
        Background="Transparent" WindowStartupLocation="Manual">

    <!-- What an image search found (PROJECT_SPEC §4.6), as a panel of its own laid out from its reference ("Results from Google"):
         Windows draws the frame and a dark backdrop as it does for the History window (Windowing/WindowFrameHost), the window's own
         buttons are at the top left (the panel has a size of its own, so only its close button works, as in the reference), its title
         after them, the results are cards in two staggered columns that pass under the title and the link along the bottom, and the link
         reports a concern. A click on a card opens its page in the browser. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource ImageSearch.CaptionHeight}" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="SystemCommands.CloseWindowCommand" Executed="OnCloseExecuted" />
    </Window.CommandBindings>

    <Grid x:Name="Root" Style="{StaticResource HistoryWorkspace}">
        <controls:FadingScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                     Focusable="False" TopFade="{StaticResource ImageSearch.TopFade}">
            <ItemsControl x:Name="Cards" ItemsSource="{Binding Cards}" Margin="{StaticResource ImageSearch.CardsMargin}"
                          IsTabStop="False" Focusable="False" AutomationProperties.Name="Results">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:StaggeredColumnsPanel Columns="2" ColumnSpacing="{StaticResource ImageSearch.ColumnSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </controls:FadingScrollViewer>

        <TextBlock x:Name="EmptyState" Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource Text.EmptyState}">
            <TextBlock.Visibility>
                <Binding Path="HasResults">
                    <Binding.Converter>
                        <controls:InvertedVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </TextBlock.Visibility>
        </TextBlock>

        <!-- Along the bottom, a bar of frosted glass that the cards scroll under, and on it the link that reports a concern. -->
        <controls:FrostedBar x:Name="Footer" VerticalAlignment="Bottom" Height="{StaticResource ImageSearch.FooterHeight}"
                             Source="{Binding ElementName=Scroller}">
            <Button x:Name="ReportButton" Style="{StaticResource ImageSearch.Link}" Command="{Binding ReportCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ReportHint}"
                    ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Report a Concern" />
        </controls:FrostedBar>

        <!-- The title band: the window's buttons, its title, and, for a sample, what it is. -->
        <StackPanel x:Name="WindowButtons" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="{StaticResource ImageSearch.ButtonsMargin}" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                    <Setter Property="Margin" Value="{StaticResource ImageSearch.ButtonSpacing}" />
                </Style>
            </StackPanel.Resources>
            <Button x:Name="CloseButton" Background="{StaticResource Brush.WindowButton.Close}" Tag="{StaticResource Icon.WindowClose}"
                    Command="SystemCommands.CloseWindowCommand" AutomationProperties.Name="Close" />
            <Button x:Name="MinimizeButton" Background="{StaticResource Brush.WindowButton.Minimize}" Tag="{StaticResource Icon.WindowMinimize}"
                    IsEnabled="False" AutomationProperties.Name="Minimize" />
            <Button x:Name="MaximizeButton" Background="{StaticResource Brush.WindowButton.Maximize}" Tag="{StaticResource Icon.WindowMaximize}"
                    IsEnabled="False" AutomationProperties.Name="Maximize" />
        </StackPanel>
        <TextBlock x:Name="Heading" Text="{Binding Heading}" Margin="{StaticResource ImageSearch.TitleMargin}" VerticalAlignment="Top"
                   HorizontalAlignment="Left" FontFamily="{StaticResource Font.Text}" FontSize="{StaticResource FontSize.ImageSearchTitle}"
                   FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.ImageSearchTitle}" TextTrimming="CharacterEllipsis"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="Notice" Text="{Binding Notice}" Margin="108.5,44,20,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
            <TextBlock.Visibility>
                <Binding Path="HasNotice">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </TextBlock.Visibility>
        </TextBlock>
    </Grid>
</Window>
