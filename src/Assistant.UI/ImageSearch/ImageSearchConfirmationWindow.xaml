<Window x:Class="Assistant.UI.ImageSearch.ImageSearchConfirmationWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search the web with this picture?"
        Width="420" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen">

    <!-- The question an image search asks before a picture leaves this PC (PROJECT_SPEC §3.4, §4.6): the picture as it would be sent, who it
         would go to, and two buttons. Cancel is the default, so Enter and Esc never send; the picture goes only when Search is pressed. -->
    <Border Margin="14" CornerRadius="18" Background="{StaticResource Brush.Surface.SidebarOpaque}"
            BorderBrush="{StaticResource Brush.Stroke.ControlRim}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="22,20,22,20">
            <TextBlock x:Name="Heading" Text="Search the web with this picture?" Style="{StaticResource Text.Heading}"
                       FontSize="{StaticResource FontSize.Body}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <Border CornerRadius="10" ClipToBounds="True" Margin="0,14,0,0" MaxHeight="220" Background="{StaticResource Brush.Surface.Gallery}"
                    HorizontalAlignment="Left">
                <Image x:Name="Picture" Stretch="Uniform" MaxHeight="220" MaxWidth="376" AutomationProperties.Name="The picture that would be sent" />
            </Border>
            <TextBlock x:Name="Body" Margin="0,14,0,0" TextWrapping="Wrap" Style="{StaticResource Text.BodySmall}"
                       Foreground="{StaticResource Brush.Text.Secondary}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource ImageSearch.DialogButton}" Content="Cancel" IsDefault="True" IsCancel="True" MinWidth="88" Padding="14,6"
                        AutomationProperties.Name="Cancel" />
                <Button x:Name="SearchButton" Style="{StaticResource ImageSearch.DialogPrimary}" Content="Search" MinWidth="88" Padding="14,6" Margin="10,0,0,0"
                        AutomationProperties.Name="Search with this picture" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
