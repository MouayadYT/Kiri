<Window x:Class="Assistant.UI.Capture.CaptureOverlayWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="clr-namespace:Assistant.UI.Capture"
        Title="Assistant screen capture"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        AllowsTransparency="False" Background="Black" WindowStartupLocation="Manual"
        UseLayoutRounding="False" SnapsToDevicePixels="False" FocusVisualStyle="{x:Null}"
        Left="0" Top="0" Width="640" Height="400">

    <!-- Visual Intelligence (PROJECT_SPEC §4.6), on one monitor: a window over the whole monitor that shows the monitor as it was when
         the capture was started, dimmed, with the selection clear, and the chips beside it (Capture/CaptureSurface.cs and
         CaptureChips.xaml, laid out from the reference). One of these covers each monitor; a selection is drawn on one of them. -->
    <Grid x:Name="Root" ClipToBounds="True">
        <capture:CaptureSurface x:Name="Surface" />
        <Canvas x:Name="ChipLayer">
            <capture:CaptureChips x:Name="Chips" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
