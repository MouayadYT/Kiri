<Project Sdk="Microsoft.NET.Sdk">

  <!-- The speech engines (PROJECT_SPEC §5.1, step 125): text-to-speech, speech recognition and the wake-word listener, each run on this PC by sherpa-onnx
       (the ONNX Runtime, with its phonemizer and data for the voices) from model files the user or the package put in the voices folders. Nothing here
       talks to a server. The runtime is native, which is why these engines are a module of their own and Core, which has the contracts, is not. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assistant.Core\Assistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Assistant.Voice.Tests" />
  </ItemGroup>

</Project>
